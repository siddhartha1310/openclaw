{"type":"message","id":"e0e8dc22","parentId":"5835cb00","timestamp":"2026-02-18T16:32:57.163Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Perfect! Now let me create one more helpful file: a simple demonstration script that shows how to use all four skills together in sequence. This will help users understand the workflow.","thinkingSignature":"reasoning"},{"type":"text","text":"Let me create a comprehensive demonstration script."},{"type":"toolCall","id":"call_e0781dbc723b4f7baaf8e9b6","name":"write","arguments":{"content":"#!/usr/bin/env node\n\n/**\n * OSINT Toolkit Demonstration\n * Shows how to use all four skills together\n */\n\nconst OSINTCrawlSkill = require('./osint-crawl');\nconst OSINTAnalyzeSkill = require('./osint-analyze');\nconst OSINTYoutubeSkill = require('./osint-youtube');\nconst OSINTSearchMultiSkill = require('./osint-search-multi');\n\nasync function demonstrate() {\n  console.log('🚀 OSINT Toolkit Demonstration\\n');\n  console.log('This script demonstrates the integrated workflow:\\n');\n\n  // ===== Option 1: Use Multi-Source Orchestrator (Recommended) =====\n  console.log('=== OPTION 1: Multi-Source Search (Orchestrator) ===\\n');\n\n  const orchestrator = new OSINTSearchMultiSkill();\n  try {\n    await orchestrator.initialize();\n\n    const query = 'OSINT open source intelligence tools';\n    console.log(`🔍 Searching for: \"${query}\"\\n`);\n\n    const results = await orchestrator.search(query, {\n      web: true,\n      youtube: true,\n      analyze: true,\n      maxWebDepth: 1,\n      maxYoutubeResults: 5,\n      deduplicate: true\n    });\n\n    console.log(`📊 Results Summary:`);\n    console.log(`   Query: ${results.query}`);\n    console.log(`   Total aggregated: ${results.metadata.totalResults}`);\n    console.log(`   Web results: ${results.metadata.sourceCounts.web || 0}`);\n    console.log(`   YouTube results: ${results.metadata.sourceCounts.youtube || 0}\\n`);\n\n    if (results.aggregated.length > 0) {\n      console.log('📋 Top Results:');\n      results.aggregated.slice(0, 3).forEach((item, idx) => {\n        console.log(`\\n${idx + 1}. [${item.sourceType.toUpperCase()}] ${item.title}`);\n        console.log(`   URL: ${item.url}`);\n        if (item.stats) {\n          console.log(`   ${item.stats.views} views | ${item.stats.likes} likes`);\n        }\n        if (item.domain) {\n          console.log(`   Domain: ${item.domain}`);\n        }\n      });\n    }\n\n    if (results.analysis) {\n      console.log('\\n📈 Analysis Summary:');\n      console.log(`   Pages analyzed: ${results.analysis.input.pageCount}`);\n      console.log(`   Top keyword: ${results.analysis.keywords[0]?.word || 'N/A'}`);\n      console.log(`   Sentiment: ${results.analysis.sentiment.type} (${results.analysis.sentiment.score})`);\n    }\n  } catch (error) {\n    console.error('Orchestrator error:', error.message);\n  }\n\n  await orchestrator.shutdown();\n\n  // ===== Option 2: Individual Skills Workflow =====\n  console.log('\\n\\n=== OPTION 2: Individual Skills Workflow ===\\n');\n\n  try {\n    // Step 1: Crawl a website\n    console.log('Step 1: Web Crawl');\n    const crawlSkill = new OSINTCrawlSkill();\n    await crawlSkill.initialize();\n\n    const crawlResults = await crawlSkill.crawl('https://example.com', {\n      maxDepth: 1,\n      followLinks: true\n    });\n\n    console.log(`   Crawled ${crawlResults.pages.length} pages\\n`);\n\n    // Step 2: Analyze crawled content\n    console.log('Step 2: Content Analysis');\n    const analyzeSkill = new OSINTAnalyzeSkill();\n    await analyzeSkill.initialize();\n\n    const analysis = await analyzeSkill.analyze(crawlResults);\n\n    console.log(`   Keywords: ${analysis.keywords.map(k => k.word).join(', ')}`);\n    console.log(`   Sentiment: ${analysis.sentiment.type}\\n`);\n\n    // Step 3: YouTube search (requires API key)\n    console.log('Step 3: YouTube Search');\n    const youtubeSkill = new OSINTYoutubeSkill();\n    try {\n      await youtubeSkill.initialize();\n\n      const youtubeResults = await youtubeSkill.search('OSINT tutorial', {\n        maxResults: 3\n      });\n\n      console.log(`   Found ${youtubeResults.totalResults} videos`);\n      youtubeResults.items.forEach(video => {\n        console.log(`   - ${video.title} (${video.viewCount} views)`);\n      });\n    } catch (e) {\n      console.log(`   ⚠️  YouTube unavailable: ${e.message}`);\n      console.log('   Set YOUTUBE_API_KEY to enable YouTube searches\\n');\n    }\n\n    await youtubeSkill?.shutdown();\n    await analyzeSkill.shutdown();\n    await crawlSkill.shutdown();\n  } catch (error) {\n    console.error('Workflow error:', error.message);\n  }\n\n  console.log('\\n\\n✅ Demonstration complete!');\n  console.log('\\n📚 See individual skill READMEs for detailed usage.');\n  console.log('📖 Master README: skills/README.md\\n');\n}\n\n// Run demonstration\nif (require.main === module) {\n  demonstrate().catch(console.error);\n}\n\nmodule.exports = { demonstrate };","file_path":"skills/demo.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":31373,"output":1221,"cacheRead":0,"cacheWrite":0,"totalTokens":32594,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771432367320}}
