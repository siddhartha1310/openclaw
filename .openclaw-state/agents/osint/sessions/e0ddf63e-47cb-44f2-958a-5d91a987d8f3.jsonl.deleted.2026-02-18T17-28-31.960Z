{"type":"message","id":"d3dee6c9","parentId":"085f4615","timestamp":"2026-02-18T16:28:25.430Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good, package.json created. Now let me create the main index.js file for osint-crawl. This skill should:\n- Accept a URL to crawl\n- Respect robots.txt\n- Rate limit requests\n- Capture page content\n- Extract links\n- Output structured JSON\n\nLet me create a comprehensive implementation.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_ff96930538374e8d923e0081","name":"write","arguments":{"content":"const fetch = require('node-fetch');\nconst cheerio = require('cheerio');\nconst RobotsParser = require('robots-parser');\n\nclass OSINTCrawlSkill {\n  constructor() {\n    this.userAgent = 'OSINT-Crawler/1.0';\n    this.delay = 1000; // 1 second between requests\n    this.maxDepth = 2;\n    this.visitedUrls = new Set();\n    this.robotsCache = new Map();\n  }\n\n  async initialize() {\n    console.log('OSINT Crawl Skill initialized');\n  }\n\n  async crawl(url, options = {}) {\n    const {\n      maxDepth = this.maxDepth,\n      followLinks = true,\n      extractContent = true,\n      extractLinks = true\n    } = options;\n\n    const results = {\n      seedUrl: url,\n      pages: [],\n      metadata: {\n        startTime: new Date().toISOString(),\n        totalPages: 0,\n        errors: []\n      }\n    };\n\n    try {\n      const allowed = await this.checkRobots(url);\n      if (!allowed) {\n        results.metadata.errors.push(`URL blocked by robots.txt: ${url}`);\n        return results;\n      }\n\n      await this.crawlRecursive(url, results, 0, maxDepth, followLinks, extractContent, extractLinks);\n    } catch (error) {\n      results.metadata.errors.push(error.message);\n    }\n\n    results.metadata.totalPages = results.pages.length;\n    results.metadata.endTime = new Date().toISOString();\n\n    return results;\n  }\n\n  async crawlRecursive(url, results, currentDepth, maxDepth, followLinks, extractContent, extractLinks) {\n    if (currentDepth > maxDepth) return;\n    if (this.visitedUrls.has(url)) return;\n\n    this.visitedUrls.add(url);\n\n    try {\n      await this.delayRequest();\n\n      const response = await fetch(url, {\n        headers: {\n          'User-Agent': this.userAgent\n        },\n        timeout: 10000\n      });\n\n      if (!response.ok) {\n        results.metadata.errors.push(`HTTP ${response.status} for ${url}`);\n        return;\n      }\n\n      const contentType = response.headers.get('content-type');\n      if (!contentType || !contentType.includes('text/html')) {\n        return;\n      }\n\n      const html = await response.text();\n      const $ = cheerio.load(html);\n\n      const pageData = {\n        url: url,\n        title: $('title').text().trim(),\n        description: $('meta[name=\"description\"]').attr('content') || '',\n        keywords: $('meta[name=\"keywords\"]').attr('content') || '',\n        contentType: contentType,\n        statusCode: response.status,\n        headers: {\n          contentType: contentType,\n          lastModified: response.headers.get('last-modified')\n        }\n      };\n\n      if (extractContent) {\n        pageData.content = this.extractMainContent($);\n        pageData.wordCount = pageData.content.split(/\\s+/).length;\n        pageData.links = extractLinks ? this.extractLinks($, url) : [];\n      }\n\n      results.pages.push(pageData);\n\n      if (followLinks && currentDepth < maxDepth) {\n        const links = pageData.links || [];\n        for (const link of links) {\n          if (this.shouldFollow(link, url)) {\n            await this.crawlRecursive(link, results, currentDepth + 1, maxDepth, followLinks, extractContent, extractLinks);\n          }\n        }\n      }\n    } catch (error) {\n      results.metadata.errors.push(`Failed to crawl ${url}: ${error.message}`);\n    }\n  }\n\n  extractMainContent($) {\n    // Try to find main content areas\n    const mainSelectors = [\n      'main',\n      'article',\n      '.content',\n      '.post-content',\n      '#content',\n      'body'\n    ];\n\n    for (const selector of mainSelectors) {\n      const element = $(selector);\n      if (element.length) {\n        return element.text()\n          .replace(/\\s+/g, ' ')\n          .replace(/\\n+/g, '\\n')\n          .trim()\n          .substring(0, 50000); // Limit content size\n      }\n    }\n\n    return $('body').text()\n      .replace(/\\s+/g, ' ')\n      .replace(/\\n+/g, '\\n')\n      .trim()\n      .substring(0, 50000);\n  }\n\n  extractLinks($, baseUrl) {\n    const links = [];\n    const base = new URL(baseUrl);\n\n    $('a[href]').each((_, element) => {\n      const href = $(element).attr('href');\n      if (!href) return;\n\n      try {\n        const absoluteUrl = new URL(href, baseUrl).href;\n        links.push(absoluteUrl);\n      } catch (e) {\n        // Skip invalid URLs\n      }\n    });\n\n    return [...new Set(links)]; // Deduplicate\n  }\n\n  shouldFollow(url, parentUrl) {\n    try {\n      const parsed = new URL(url);\n      const parent = new URL(parentUrl);\n\n      // Stay on same domain by default\n      if (parsed.hostname !== parent.hostname) return false;\n\n      // Skip common non-content extensions\n      const skipExtensions = ['.pdf', '.jpg', '.jpeg', '.png', '.gif', '.zip', '.exe'];\n      if (skipExtensions.some(ext => url.toLowerCase().endsWith(ext))) {\n        return false;\n      }\n\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  async checkRobots(url) {\n    try {\n      const parsed = new URL(url);\n      const robotsUrl = `${parsed.protocol}//${parsed.hostname}/robots.txt`;\n\n      if (this.robotsCache.has(robotsUrl)) {\n        const robots = this.robotsCache.get(robotsUrl);\n        return robots.isAllowed(url, this.userAgent);\n      }\n\n      const response = await fetch(robotsUrl, {\n        headers: {\n          'User-Agent': this.userAgent\n        },\n        timeout: 5000\n      });\n\n      if (response.ok) {\n        const robotsText = await response.text();\n        const robots = RobotsParser(robotsUrl, robotsText);\n        this.robotsCache.set(robotsUrl, robots);\n        return robots.isAllowed(url, this.userAgent);\n      }\n\n      return true; // If no robots.txt, allow by default\n    } catch {\n      return true; // On error, allow by default\n    }\n  }\n\n  delayRequest() {\n    return new Promise(resolve => setTimeout(resolve, this.delay));\n  }\n\n  async shutdown() {\n    console.log('OSINT Crawl Skill shutting down');\n  }\n}\n\nmodule.exports = OSINTCrawlSkill;","file_path":"skills/osint-crawl/index.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":11206,"output":1636,"cacheRead":0,"cacheWrite":0,"totalTokens":12842,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771432094631}}
