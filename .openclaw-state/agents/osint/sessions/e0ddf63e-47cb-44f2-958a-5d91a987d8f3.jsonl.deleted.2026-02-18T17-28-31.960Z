{"type":"message","id":"764370d9","parentId":"360ff0f7","timestamp":"2026-02-18T16:31:34.645Z","message":{"role":"toolResult","toolCallId":"call_d8d96b6558c446f3b99df258","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"osint-youtube\",\n  \"version\": \"1.0.0\",\n  \"description\": \"YouTube search skill using YouTube Data API v3\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"start\": \"node index.js\",\n    \"test\": \"node test.js\"\n  },\n  \"keywords\": [\n    \"osint\",\n    \"youtube\",\n    \"video\",\n    \"search\",\n    \"openclaw\"\n  ],\n  \"author\": \"OSINT Toolkit\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"node-fetch\": \"^3.3.2\"\n  }\n}"}],"isError":false,"timestamp":1771432294642}}
