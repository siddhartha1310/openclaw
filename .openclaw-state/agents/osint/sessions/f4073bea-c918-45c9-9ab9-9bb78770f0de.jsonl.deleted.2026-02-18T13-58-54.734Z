{"type":"message","id":"65c230a0","parentId":"2e83f91c","timestamp":"2026-02-18T12:59:42.177Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the actual implementation file for osint-crawl. I'll create a comprehensive crawler that supports both Cheerio for static sites and optional Puppeteer for dynamic sites.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_7887b536fdbb4df680674f21","name":"write","arguments":{"content":"#!/usr/bin/env node\n\nimport puppeteer from 'puppeteer';\nimport cheerio from 'cheerio';\nimport axios from 'axios';\nimport { URL } from 'url';\nimport { parse } from 'robots-parser';\nimport pLimit from 'p-limit';\nimport fs from 'fs';\nimport { pipeline } from 'stream/promises';\nimport { createWriteStream } from 'fs';\nimport { stringify } from 'csv-stringify/sync';\nimport { parse: csvParse } from 'csv-parse/sync';\n\n/**\n * OSINT Web Crawler - Recursive site crawling with depth limits and polite delays\n */\n\nclass OSINTCrawler {\n  constructor(options = {}) {\n    this.options = {\n      depth: 2,\n      delay: 1000,\n      maxPages: 50,\n      output: null,\n      format: 'json',\n      respectRobots: true,\n      userAgent: 'OpenClaw-OSINT-Crawler/1.0',\n      timeout: 30000,\n      includeExternal: false,\n      headless: false,\n      extractLinks: true,\n      ...options\n    };\n\n    this.visited = new Set();\n    this.results = [];\n    this.robotsCache = new Map();\n    this.pagesCrawled = 0;\n    this.limit = pLimit(2); // Max 2 concurrent requests\n  }\n\n  async crawl(startUrl) {\n    console.log(`[OSINT] Starting crawl: ${startUrl}`);\n    console.log(`[OSINT] Options: depth=${this.options.depth}, maxPages=${this.options.maxPages}, delay=${this.options.delay}ms`);\n\n    await this.crawlRecursive(startUrl, 0);\n    \n    if (this.options.output) {\n      await this.saveResults();\n    }\n\n    return this.results;\n  }\n\n  async crawlRecursive(url, currentDepth) {\n    if (this.pagesCrawled >= this.options.maxPages) {\n      console.log(`[OSINT] Max pages reached (${this.options.maxPages})`);\n      return;\n    }\n\n    if (this.visited.has(url)) {\n      return;\n    }\n\n    if (currentDepth > this.options.depth) {\n      return;\n    }\n\n    // Check robots.txt if enabled\n    if (this.options.respectRobots) {\n      const canFetch = await this.checkRobots(url);\n      if (!canFetch) {\n        console.log(`[OSINT] Blocked by robots.txt: ${url}`);\n        return;\n      }\n    }\n\n    this.visited.add(url);\n\n    try {\n      const pageData = await this.fetchPage(url);\n      this.results.push(pageData);\n      this.pagesCrawled++;\n\n      console.log(`[OSINT] Crawled (${this.pagesCrawled}/${this.options.maxPages}): ${url} - ${pageData.statusCode}`);\n\n      if (this.options.extractLinks && pageData.links && currentDepth < this.options.depth) {\n        const links = this.filterLinks(pageData.links, url);\n        \n        // Process links with delay\n        for (const link of links) {\n          await this.delay(this.options.delay);\n          await this.crawlRecursive(link, currentDepth + 1);\n        }\n      }\n    } catch (error) {\n      console.error(`[OSINT] Error crawling ${url}:`, error.message);\n      this.results.push({\n        url,\n        error: error.message,\n        crawledAt: new Date().toISOString()\n      });\n    }\n  }\n\n  async fetchPage(url) {\n    const result = await this.limit(async () => {\n      if (this.options.headless) {\n        return this.fetchWithPuppeteer(url);\n      } else {\n        return this.fetchWithAxios(url);\n      }\n    });\n    return result;\n  }\n\n  async fetchWithAxios(url) {\n    const response = await axios.get(url, {\n      timeout: this.options.timeout,\n      headers: {\n        'User-Agent': this.options.userAgent\n      },\n      maxRedirects: 5,\n      validateStatus: () => true // Don't throw on 4xx/5xx\n    });\n\n    const $ = cheerio.load(response.data);\n    const links = this.extractLinksFromPage($, response.request.res.responseUrl || url);\n\n    return {\n      url,\n      title: $('title').text().trim() || '',\n      statusCode: response.status,\n      contentLength: response.headers['content-length'] ? parseInt(response.headers['content-length']) : response.data.length,\n      links: links,\n      crawledAt: new Date().toISOString()\n    };\n  }\n\n  async fetchWithPuppeteer(url) {\n    let browser = null;\n    try {\n      browser = await puppeteer.launch({\n        headless: 'new',\n        args: ['--no-sandbox', '--disable-setuid-sandbox']\n      });\n\n      const page = await browser.newPage();\n      await page.setUserAgent(this.options.userAgent);\n      await page.setDefaultNavigationTimeout(this.options.timeout);\n\n      const response = await page.goto(url, { waitUntil: 'networkidle2' });\n      const content = await page.content();\n      const $ = cheerio.load(content);\n\n      // Extract links after JS execution\n      const links = this.extractLinksFromPage($, url);\n\n      return {\n        url,\n        title: await page.title() || '',\n        statusCode: response.status(),\n        contentLength: content.length,\n        links: links,\n        crawledAt: new Date().toISOString()\n      };\n    } finally {\n      if (browser) {\n        await browser.close();\n      }\n    }\n  }\n\n  extractLinksFromPage($, baseUrl) {\n    const links = [];\n    const base = new URL(baseUrl);\n\n    $('a[href]').each((_, element) => {\n      const href = $(element).attr('href');\n      if (href) {\n        try {\n          const absoluteUrl = new URL(href, baseUrl).href;\n          links.push(absoluteUrl);\n        } catch (e) {\n          // Skip invalid URLs\n        }\n      }\n    });\n\n    return [...new Set(links)]; // Deduplicate\n  }\n\n  filterLinks(links, baseUrl) {\n    const base = new URL(baseUrl);\n    return links.filter(link => {\n      try {\n        const url = new URL(link);\n        \n        // Skip external links if not enabled\n        if (!this.options.includeExternal && url.hostname !== base.hostname) {\n          return false;\n        }\n\n        // Skip non-HTTP(S) links\n        if (!['http:', 'https:'].includes(url.protocol)) {\n          return false;\n        }\n\n        // Skip common file types\n        const skipExtensions = ['.pdf', '.jpg', '.png', '.gif', '.zip', '.exe', '.svg'];\n        if (skipExtensions.some(ext => url.pathname.toLowerCase().endsWith(ext))) {\n          return false;\n        }\n\n        return true;\n      } catch (e) {\n        return false;\n      }\n    });\n  }\n\n  async checkRobots(url) {\n    const parsedUrl = new URL(url);\n    const robotsUrl = `${parsedUrl.protocol}//${parsedUrl.hostname}/robots.txt`;\n\n    if (this.robotsCache.has(robotsUrl)) {\n      const robots = this.robotsCache.get(robotsUrl);\n      return robots.isAllowed(url, this.options.userAgent);\n    }\n\n    try {\n      const response = await axios.get(robotsUrl, { timeout: 5000 });\n      const robots = parse(response.data);\n      this.robotsCache.set(robotsUrl, robots);\n      return robots.isAllowed(url, this.options.userAgent);\n    } catch (e) {\n      // If we can't fetch robots.txt, assume allowed\n      return true;\n    }\n  }\n\n  delay(ms) {\n    return new Promise(resolve => setTimeout(resolve, ms));\n  }\n\n  async saveResults() {\n    let data = this.results;\n    \n    if (this.options.format === 'csv') {\n      // Flatten for CSV\n      data = this.results.map(r => ({\n        url: r.url,\n        title: r.title || '',\n        statusCode: r.statusCode || '',\n        contentLength: r.contentLength || '',\n        crawledAt: r.crawledAt,\n        linksFound: r.links ? r.links.length : 0,\n        error: r.error || ''\n      }));\n\n      const csv = stringify(data, { header: true });\n      await fs.promises.writeFile(this.options.output, csv, 'utf8');\n    } else {\n      await fs.promises.writeFile(this.options.output, JSON.stringify(data, null, 2), 'utf8');\n    }\n\n    console.log(`[OSINT] Results saved to ${this.options.output} (${this.results.length} pages)`);\n  }\n}\n\n// CLI Interface\nif (import.meta.url === `file://${process.argv[1]}`) {\n  const args = parseArgs(process.argv.slice(2));\n  \n  const crawler = new OSINTCrawler(args.options);\n  \n  crawler.crawl(args.url)\n    .then(results => {\n      console.log(`\\n[OSINT] Crawl complete. Total pages: ${results.length}`);\n      process.exit(0);\n    })\n    .catch(error => {\n      console.error('[OSINT] Fatal error:', error);\n      process.exit(1);\n    });\n}\n\nfunction parseArgs(args) {\n  const result = { url: null, options: {} };\n  \n  for (let i = 0; i < args.length; i++) {\n    const arg = args[i];\n    \n    if (!arg.startsWith('-') && !result.url) {\n      result.url = arg;\n      continue;\n    }\n\n    switch (arg) {\n      case '--depth':\n      case '-d':\n        result.options.depth = parseInt(args[++i]);\n        break;\n      case '--delay':\n      case '-D':\n        result.options.delay = parseInt(args[++i]);\n        break;\n      case '--max-pages':\n      case '-m':\n        result.options.maxPages = parseInt(args[++i]);\n        break;\n      case '--output':\n      case '-o':\n        result.options.output = args[++i];\n        break;\n      case '--format':\n      case '-f':\n        result.options.format = args[++i];\n        break;\n      case '--respect-robots':\n      case '-r':\n        result.options.respectRobots = args[++i] !== 'false';\n        break;\n      case '--user-agent':\n      case '-u':\n        result.options.userAgent = args[++i];\n        break;\n      case '--timeout':\n      case '-t':\n        result.options.timeout = parseInt(args[++i]);\n        break;\n      case '--include-external':\n      case '-e':\n        result.options.includeExternal = true;\n        break;\n      case '--headless':\n        result.options.headless = true;\n        break;\n    }\n  }\n\n  if (!result.url) {\n    console.error('Usage: osint-crawl <url> [options]');\n    process.exit(1);\n  }\n\n  return result;\n}\n\nexport default OSINTCrawler;","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-crawl\\osint-crawl.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":14849,"output":2555,"cacheRead":0,"cacheWrite":0,"totalTokens":17404,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419567999}}
{"type":"message","id":"511605fa","parentId":"65c230a0","timestamp":"2026-02-18T12:59:42.193Z","message":{"role":"toolResult","toolCallId":"call_7887b536fdbb4df680674f21","toolName":"write","content":[{"type":"text","text":"Successfully wrote 9341 bytes to D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-crawl\\osint-crawl.js"}],"isError":false,"timestamp":1771419582191}}
{"type":"message","id":"70f6d565","parentId":"511605fa","timestamp":"2026-02-18T12:59:49.725Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Great! Now I'll create the osint-analyze skill. This will take CSV/JSON datasets and produce summary statistics, trends, and outliers.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_dd899a69290f4b11b80f265f","name":"write","arguments":{"content":"# osint-analyze - Data Analysis Tool\n\n## Description\nTake dataset (CSV/JSON) and produce summary statistics, trends, and outliers. Uses simple-statistics for comprehensive analysis including mean, median, std dev, quartiles, z-scores, and trend detection.\n\n## Usage\n```\nosint-analyze <file> [options]\n```\n\n## Parameters\n- `file` (required): Input file path (CSV or JSON)\n- `--output, -o` (optional): Output file for results (default: console)\n- `--format, -f` (optional): Output format: 'json', 'csv', or 'text' (default: 'text')\n- `--columns, -c` (optional): Comma-separated list of columns to analyze (default: all numeric)\n- `--outliers, -O` (optional): Outlier detection method: 'iqr' (default) or 'zscore'\n- `--threshold, -T` (optional): Outlier threshold (default: 1.5 for IQR, 3 for z-score)\n- `--trends, -t` (optional): Enable trend analysis (slope, correlation)\n- `--dates, -d` (optional): Date column for time-series analysis\n- `--groupby, -g` (optional): Column to group analysis by\n\n## Examples\n\n**Analyze all numeric columns:**\n```\nosint-analyze data.csv\n```\n\n**Specific columns with outlier detection:**\n```\nosint-analyze data.json --columns revenue,users,clicks --outliers iqr\n```\n\n**Time series analysis:**\n```\nosint-analyze metrics.csv --dates timestamp --trends\n```\n\n**Grouped analysis:**\n```\nosint-analyze sales.csv --groupby region --format json --output report.json\n```\n\n## Output\nReturns structured statistics for each numeric column:\n- `count`: Number of values\n- `mean`: Arithmetic mean\n- `median`: Middle value\n- `stdDev`: Standard deviation\n- `variance`: Variance\n- `min`: Minimum value\n- `max`: Maximum value\n- `q1`: First quartile (25th percentile)\n- `q3`: Third quartile (75th percentile)\n- `iqr`: Interquartile range\n- `outliers`: Array of outlier values and their indices\n- `skewness`: Distribution skewness (if enabled)\n- `kurtosis`: Kurtosis (if enabled)\n\nIf `--trends` enabled:\n- `slope`: Linear regression slope\n- `intercept`: Linear regression intercept\n- `r2`: R-squared coefficient of determination\n- `correlation`: Pearson correlation (if time-series)\n\n## Capabilities\n- ✅ Automatic numeric column detection\n- ✅ CSV and JSON input support\n- ✅ Multiple outlier detection methods (IQR, z-score)\n- ✅ Time-series trend analysis with linear regression\n- ✅ Grouped statistics\n- ✅ Multi-format output (text, JSON, CSV)\n- ✅ Missing value handling (ignored in calculations)\n- ✅ Skewness and kurtosis analysis\n\n## Limitations\n- Only analyzes numeric columns (non-numeric columns ignored unless used for grouping/dates)\n- Date parsing requires consistent formats (ISO 8601 recommended)\n- Outlier detection assumes roughly normal distribution for z-score method\n- No interpolation for missing data - values are excluded\n- Linear regression assumes linear relationships\n\n## Notes\n- Use `--outliers zscore` for normally distributed data, `--outliers iqr` for robust detection\n- For large datasets (>100k rows), consider sampling first\n- Grouped analysis creates separate stats for each unique group value\n- Time-series analysis requires monotonically increasing dates","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-analyze\\SKILL.md"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":17409,"output":913,"cacheRead":0,"cacheWrite":0,"totalTokens":18322,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419582193}}
