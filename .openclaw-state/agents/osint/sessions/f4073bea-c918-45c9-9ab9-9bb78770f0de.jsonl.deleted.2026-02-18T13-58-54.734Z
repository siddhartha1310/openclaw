{"type":"message","id":"07a553cb","parentId":"ecf1341d","timestamp":"2026-02-18T13:00:07.008Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the implementation for osint-analyze. This will be a comprehensive data analysis tool.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_277dd080b4c5471785fd20bb","name":"write","arguments":{"content":"#!/usr/bin/env node\n\nimport fs from 'fs';\nimport { parse } from 'csv-parse/sync';\nimport { stringify } from 'csv-stringify/sync';\nimport {\n  mean,\n  median,\n  standardDeviation,\n  variance,\n  min,\n  max,\n  quantile,\n  skew,\n  kurtosis,\n  linearRegression,\n  correlation\n} from 'simple-statistics';\n\n/**\n * OSINT Data Analyzer - Statistical analysis for datasets\n */\n\nclass OSINTAnalyzer {\n  constructor(options = {}) {\n    this.options = {\n      output: null,\n      format: 'text',\n      columns: null,\n      outlierMethod: 'iqr',\n      outlierThreshold: 1.5,\n      trends: false,\n      dates: null,\n      groupBy: null,\n      ...options\n    };\n  }\n\n  async analyze(filePath) {\n    console.log(`[OSINT] Analyzing: ${filePath}`);\n\n    const data = await this.loadData(filePath);\n    \n    if (this.options.groupBy && this.options.groupBy in data[0]) {\n      return this.analyzeGrouped(data);\n    } else {\n      return this.analyzeDataset(data);\n    }\n  }\n\n  async loadData(filePath) {\n    const ext = filePath.split('.').pop().toLowerCase();\n    const content = await fs.promises.readFile(filePath, 'utf8');\n\n    if (ext === 'csv') {\n      const records = parse(content, {\n        columns: true,\n        skip_empty_lines: true,\n        trim: true\n      });\n      return this.normalizeData(records);\n    } else if (ext === 'json') {\n      const data = JSON.parse(content);\n      return Array.isArray(data) ? data : [data];\n    } else {\n      throw new Error(`Unsupported format: ${ext}. Use CSV or JSON.`);\n    }\n  }\n\n  normalizeData(records) {\n    return records.map(row => {\n      const normalized = {};\n      for (const [key, value] of Object.entries(row)) {\n        const num = Number(value);\n        normalized[key] = isNaN(num) ? value : num;\n      }\n      return normalized;\n    });\n  }\n\n  analyzeDataset(data) {\n    console.log(`[OSINT] Records: ${data.length}`);\n\n    // Get numeric columns\n    const numericColumns = this.getNumericColumns(data);\n    \n    if (this.options.columns) {\n      const requested = this.options.columns.split(',').map(c => c.trim());\n      numericColumns.current = numericColumns.current.filter(col => requested.includes(col));\n    }\n\n    console.log(`[OSINT] Analyzing columns: ${numericColumns.current.join(', ')}`);\n\n    const results = {\n      datasetInfo: {\n        totalRecords: data.length,\n        columnsAnalyzed: numericColumns.current.length,\n        analysisDate: new Date().toISOString()\n      },\n      statistics: {}\n    };\n\n    for (const column of numericColumns.current) {\n      const values = data\n        .map(row => row[column])\n        .filter(val => typeof val === 'number' && !isNaN(val));\n\n      if (values.length === 0) continue;\n\n      const stats = this.calculateStatistics(values, column);\n\n      if (this.options.trends && this.options.dates && this.options.dates in data[0]) {\n        const xValues = data.map(row => {\n          const date = new Date(row[this.options.dates]);\n          return date.getTime();\n        }).filter(t => !isNaN(t));\n\n        const yValues = data.map(row => row[column]).filter(v => typeof v === 'number');\n\n        if (xValues.length === yValues.length && xValues.length > 1) {\n          const slope = linearRegression(xValues.map((x, i) => [x, yValues[i]]));\n          const corr = correlation(xValues, yValues);\n          \n          stats.trends = {\n            slope: slope.m,\n            intercept: slope.b,\n            r2: this.calculateR2(xValues, yValues, slope),\n            correlation: corr,\n            n: xValues.length\n          };\n        }\n      }\n\n      results.statistics[column] = stats;\n    }\n\n    return results;\n  }\n\n  analyzeGrouped(data) {\n    const groups = {};\n    const groupKey = this.options.groupBy;\n\n    for (const row of data) {\n      const key = String(row[groupKey] ?? 'undefined');\n      if (!groups[key]) groups[key] = [];\n      groups[key].push(row);\n    }\n\n    console.log(`[OSINT] Groups: ${Object.keys(groups).length}`);\n\n    const results = {\n      groupBy: groupKey,\n      groups: {},\n      analysisDate: new Date().toISOString()\n    };\n\n    for (const [group, records] of Object.entries(groups)) {\n      results.groups[group] = this.analyzeDataset(records).statistics;\n    }\n\n    return results;\n  }\n\n  getNumericColumns(data) {\n    if (data.length === 0) return { current: [], all: [] };\n\n    const sample = data[0];\n    const numeric = [];\n\n    for (const [key, value] of Object.entries(sample)) {\n      if (typeof value === 'number' && !isNaN(value)) {\n        numeric.push(key);\n      }\n    }\n\n    return {\n      current: numeric,\n      all: numeric\n    };\n  }\n\n  calculateStatistics(values, column) {\n    const sorted = [...values].sort((a, b) => a - b);\n    const q1 = quantile(sorted, 0.25);\n    const q3 = quantile(sorted, 0.75);\n    const iqr = q3 - q1;\n\n    let outliers = [];\n    if (this.options.outlierMethod === 'iqr') {\n      const lower = q1 - this.options.outlierThreshold * iqr;\n      const upper = q3 + this.options.outlierThreshold * iqr;\n      outliers = values.filter(v => v < lower || v > upper).map(v => ({ value: v }));\n    } else if (this.options.outlierMethod === 'zscore') {\n      const mu = mean(values);\n      const sigma = standardDeviation(values);\n      outliers = values\n        .map((v, i) => ({ value: v, index: i, zscore: Math.abs((v - mu) / sigma) }))\n        .filter(item => item.zscore > this.options.outlierThreshold);\n    }\n\n    return {\n      count: values.length,\n      mean: mean(values),\n      median: median(values),\n      stdDev: standardDeviation(values),\n      variance: variance(values),\n      min: min(values),\n      max: max(values),\n      q1,\n      q3,\n      iqr,\n      outliers: outliers.slice(0, 100), // Limit to 100 outliers\n      skewness: skew(values),\n      kurtosis: kurtosis(values),\n      sum: values.reduce((a, b) => a + b, 0)\n    };\n  }\n\n  calculateR2(x, y, regression) {\n    const meanY = mean(y);\n    let ssRes = 0, ssTot = 0;\n    \n    for (let i = 0; i < x.length; i++) {\n      const predicted = regression.m * x[i] + regression.b;\n      ssRes += Math.pow(y[i] - predicted, 2);\n      ssTot += Math.pow(y[i] - meanY, 2);\n    }\n    \n    return 1 - (ssRes / ssTot);\n  }\n\n  async saveResults(results, outputPath, format) {\n    let content;\n    \n    if (format === 'json') {\n      content = JSON.stringify(results, null, 2);\n    } else if (format === 'csv') {\n      // Flatten statistics to CSV\n      const rows = [];\n      const header = ['column', 'metric', 'value'];\n      rows.push(header);\n\n      for (const [column, stats] of Object.entries(results.statistics)) {\n        for (const [metric, value] of Object.entries(stats)) {\n          if (metric !== 'outliers') {\n            rows.push([column, metric, value]);\n          }\n        }\n      }\n\n      content = stringify(rows, { header: false });\n    } else {\n      content = this.formatText(results);\n    }\n\n    await fs.promises.writeFile(outputPath, content, 'utf8');\n    console.log(`[OSINT] Results saved to ${outputPath}`);\n  }\n\n  formatText(results) {\n    const lines = [];\n    lines.push('===============================================');\n    lines.push('           OSINT DATA ANALYSIS REPORT         ');\n    lines.push('===============================================\\n');\n    \n    lines.push(`Dataset Info:`);\n    lines.push(`  Total Records: ${results.datasetInfo.totalRecords}`);\n    lines.push(`  Columns Analyzed: ${results.datasetInfo.columnsAnalyzed}`);\n    lines.push(`  Analysis Date: ${results.datasetInfo.analysisDate}\\n`);\n\n    for (const [column, stats] of Object.entries(results.statistics)) {\n      lines.push(`Column: ${column}`);\n      lines.push(`  Count: ${stats.count}`);\n      lines.push(`  Mean: ${stats.mean.toFixed(4)}`);\n      lines.push(`  Median: ${stats.median.toFixed(4)}`);\n      lines.push(`  Std Dev: ${stats.stdDev.toFixed(4)}`);\n      lines.push(`  Variance: ${stats.variance.toFixed(4)}`);\n      lines.push(`  Range: ${stats.min.toFixed(4)} - ${stats.max.toFixed(4)}`);\n      lines.push(`  Q1: ${stats.q1.toFixed(4)}, Q3: ${stats.q3.toFixed(4)}, IQR: ${stats.iqr.toFixed(4)}`);\n      lines.push(`  Outliers: ${stats.outliers.length}`);\n      lines.push(`  Skewness: ${stats.skewness.toFixed(4)}`);\n      lines.push(`  Kurtosis: ${stats.kurtosis.toFixed(4)}`);\n      \n      if (stats.trends) {\n        lines.push(`  Trend:`);\n        lines.push(`    Slope: ${stats.trends.slope.toFixed(6)}`);\n        lines.push(`    R²: ${stats.trends.r2.toFixed(4)}`);\n        lines.push(`    Correlation: ${stats.trends.correlation.toFixed(4)}`);\n      }\n      \n      lines.push('');\n    }\n\n    return lines.join('\\n');\n  }\n}\n\n// CLI Interface\nif (import.meta.url === `file://${process.argv[1]}`) {\n  const args = parseArgs(process.argv.slice(2));\n  \n  const analyzer = new OSINTAnalyzer(args.options);\n  \n  analyzer.analyze(args.file)\n    .then(results => {\n      if (args.options.output) {\n        return analyzer.saveResults(results, args.options.output, args.options.format);\n      } else {\n        console.log(analyzer.formatText(results));\n        return results;\n      }\n    })\n    .then(() => process.exit(0))\n    .catch(error => {\n      console.error('[OSINT] Analysis failed:', error.message);\n      process.exit(1);\n    });\n}\n\nfunction parseArgs(args) {\n  const result = { file: null, options: {} };\n  \n  for (let i = 0; i < args.length; i++) {\n    const arg = args[i];\n    \n    if (!arg.startsWith('-') && !result.file) {\n      result.file = arg;\n      continue;\n    }\n\n    switch (arg) {\n      case '--output':\n      case '-o':\n        result.options.output = args[++i];\n        break;\n      case '--format':\n      case '-f':\n        result.options.format = args[++i];\n        break;\n      case '--columns':\n      case '-c':\n        result.options.columns = args[++i];\n        break;\n      case '--outliers':\n      case '-O':\n        result.options.outlierMethod = args[++i];\n        break;\n      case '--threshold':\n      case '-T':\n        result.options.outlierThreshold = parseFloat(args[++i]);\n        break;\n      case '--trends':\n      case '-t':\n        result.options.trends = true;\n        break;\n      case '--dates':\n      case '-d':\n        result.options.dates = args[++i];\n        break;\n      case '--groupby':\n      case '-g':\n        result.options.groupBy = args[++i];\n        break;\n    }\n  }\n\n  if (!result.file) {\n    console.error('Usage: osint-analyze <file> [options]');\n    process.exit(1);\n  }\n\n  return result;\n}\n\nexport default OSINTAnalyzer;","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-analyze\\osint-analyze.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":18339,"output":2829,"cacheRead":0,"cacheWrite":0,"totalTokens":21168,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419589753}}
{"type":"message","id":"ba3d61a8","parentId":"07a553cb","timestamp":"2026-02-18T13:00:07.031Z","message":{"role":"toolResult","toolCallId":"call_277dd080b4c5471785fd20bb","toolName":"write","content":[{"type":"text","text":"Successfully wrote 10468 bytes to D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-analyze\\osint-analyze.js"}],"isError":false,"timestamp":1771419607028}}
{"type":"message","id":"b767a672","parentId":"ba3d61a8","timestamp":"2026-02-18T13:00:19.091Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the osint-youtube skill. This will fetch video info, transcripts, and comments. I'll use ytdl-core for the core functionality, with fallback options.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_a04a67f32b8147199088c62b","name":"write","arguments":{"content":"# osint-youtube - YouTube Data Extractor\n\n## Description\nExtract comprehensive YouTube video information including metadata, transcripts (captions), and comments. Supports both ytdl-core and youtube-dl-exec as fallback.\n\n## Usage\n```\nosint-youtube <video-id-or-url> [options]\n```\n\n## Parameters\n- `video-id-or-url` (required): YouTube video ID or full URL\n- `--output, -o` (optional): Output file path\n- `--format, -f` (optional): Output format: 'json', 'text' (default: 'text')\n- `--info, -i` (optional): Extract video info only (default: true)\n- `--transcript, -t` (optional): Extract transcript/captions (default: false)\n- `--comments, -c` (optional): Extract comments (default: false)\n- `--max-comments, -m` (optional): Maximum comments to fetch (default: 100)\n- `--lang, -l` (optional): Preferred transcript language (default: 'en')\n- `--proxy, -p` (optional): Proxy URL (for geo-restricted content)\n- `--cookies, -C` (optional): Path to cookies.txt file\n- `--include-replies, -r` (optional): Include comment replies (default: false)\n\n## Examples\n\n**Get video info:**\n```\nosint-youtube dQw4w9WgXcQ\n```\n\n**Full extraction with transcript and comments:**\n```\nosint-youtube https://youtu.be/dQw4w9WgXcQ --transcript --comments --max-comments 50\n```\n\n**Extract transcript in Spanish:**\n```\nosint-youtube video-id --transcript --lang es --output transcript.txt\n```\n\n**Extract comments with replies:**\n```\nosint-youtube video-id --comments --include-replies --max-comments 200\n```\n\n## Output\nVideo Info includes:\n- `id`: Video ID\n- `title`: Video title\n- `description`: Full description\n- `channelId`, `channelTitle`: Channel info\n- `viewCount`, `likeCount`, `commentCount`: Engagement metrics\n- `duration`: Duration in seconds\n- `uploadDate`: ISO date\n- `thumbnails`: Array of thumbnail URLs (various resolutions)\n- `categories`, `tags`: Video metadata\n- `isLive`: Live status\n- `license`: Content license\n- `allowedRegions`: Geographic availability\n\nTranscript includes:\n- `language`: Language code\n- `isManual`: True if human-generated, false if auto-generated\n- `segments`: Array of {start, duration, text}\n\nComments include:\n- `author`, `authorId`: Commenter info\n- `text`: Comment text\n- `likeCount`: Likes on comment\n- `publishedAt`: Timestamp\n- `replyCount`: Number of replies\n- `replies`: Array of reply objects (if --include-replies)\n\n## Capabilities\n- ✅ Video metadata extraction\n- ✅ Caption/transcript extraction (auto and manual)\n- ✅ Comment extraction with pagination\n- ✅ Comment replies (optional)\n- ✅ Multi-language transcript support\n- ✅ Proxy support for geo-restricted content\n- ✅ Cookie support for age-restricted/region-locked videos\n- ✅ Both ytdl-core and youtube-dl-exec (fallback)\n\n## Limitations\n- Requires YouTube access (may be blocked in some regions)\n- Age-restricted videos require cookies from authenticated session\n- Geo-blocked content requires appropriate proxy\n- Transcripts not always available (creator disabled)\n- Comment extraction limited by YouTube's rate limits\n- Large comment threads may hit --max-comments limit\n- youtube-dl-exec requires Python installed on system\n\n## Notes\n- Transcript extraction tries manual captions first, then auto-generated\n- Use --cookies with browser export tools for restricted content\n- Respect YouTube's Terms of Service - use responsibly\n- Comments are public data but rate-limited\n- Video info extraction is generally reliable; transcript/comments less so","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-youtube\\SKILL.md"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":21196,"output":1003,"cacheRead":0,"cacheWrite":0,"totalTokens":22199,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419607031}}
