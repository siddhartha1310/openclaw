{"type":"message","id":"0848d30b","parentId":"b32c97b7","timestamp":"2026-02-18T13:03:26.408Z","message":{"role":"toolResult","toolCallId":"call_ed82926b35db4c1c9eed2c89","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"openclaw-osint-toolkit\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Comprehensive OSINT toolkit for OpenClaw with web crawling, data analysis, YouTube analysis, and multi-engine search\",\n  \"main\": \"index.js\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [\n    \"openclaw\",\n    \"osint\",\n    \"web-crawling\",\n    \"youtube\",\n    \"data-analysis\",\n    \"search\"\n  ],\n  \"author\": \"OpenClaw OSINT Team\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"puppeteer\": \"^23.0.0\",\n    \"cheerio\": \"^1.0.0-rc.12\",\n    \"axios\": \"^1.6.0\",\n    \"csv-parser\": \"^3.0.0\",\n    \"fast-csv\": \"^4.3.6\",\n    \"json2csv\": \"^6.0.0-alpha.2\",\n    \"simple-statistics\": \"^7.8.3\",\n    \"ytdl-core\": \"^4.11.5\",\n    \"youtube-dl-exec\": \"^2.4.2\",\n    \"node-fetch\": \"^3.3.2\",\n    \"p-limit\": \"^3.1.0\",\n    \"robots-parser\": \"^3.0.0\",\n    \"user-agents\": \"^1.0.1349\"\n  },\n  \"engines\": {\n    \"node\": \">=18.0.0\"\n  }\n}"}],"isError":false,"timestamp":1771419806406}}
