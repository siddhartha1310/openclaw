{"type":"message","id":"1ed526be","parentId":"b6f1dea1","timestamp":"2026-02-18T13:00:44.352Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the implementation for osint-youtube. This will use ytdl-core as the primary method and have fallback to youtube-dl-exec.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_a5dd2ac4df374bd491da7dd3","name":"write","arguments":{"content":"#!/usr/bin/env node\n\nimport ytdl from 'ytdl-core';\nimport { exec } from 'child_process';\nimport { promisify } from 'util';\nimport fs from 'fs';\nimport { pipeline } from 'stream/promises';\n\nconst execAsync = promisify(exec);\n\n/**\n * OSINT YouTube Extractor - Video info, transcripts, and comments\n */\n\nclass OSINTYouTube {\n  constructor(options = {}) {\n    this.options = {\n      output: null,\n      format: 'text',\n      info: true,\n      transcript: false,\n      comments: false,\n      maxComments: 100,\n      lang: 'en',\n      proxy: null,\n      cookies: null,\n      includeReplies: false,\n      ...options\n    };\n  }\n\n  async extract(videoInput) {\n    console.log(`[OSINT] YouTube extraction: ${videoInput}`);\n\n    const videoId = this.extractVideoId(videoInput);\n    \n    if (!videoId) {\n      throw new Error('Invalid YouTube video ID or URL');\n    }\n\n    const results = { videoId };\n\n    try {\n      // Get video info\n      if (this.options.info) {\n        console.log('[OSINT] Fetching video info...');\n        results.info = await this.getVideoInfo(videoId);\n      }\n\n      // Get transcript\n      if (this.options.transcript) {\n        console.log('[OSINT] Fetching transcript...');\n        results.transcript = await this.getTranscript(videoId);\n      }\n\n      // Get comments\n      if (this.options.comments) {\n        console.log('[OSINT] Fetching comments...');\n        results.comments = await this.getComments(videoId);\n      }\n\n      if (this.options.output) {\n        await this.saveResults(results);\n      }\n\n      return results;\n    } catch (error) {\n      console.error('[OSINT] YouTube extraction error:', error.message);\n      \n      // Try fallback with youtube-dl if ytdl-core fails\n      if (error.message.includes('Private video') || \n          error.message.includes('Video unavailable') ||\n          error.message.includes('age') ||\n          error.message.includes('region')) {\n        console.log('[OSINT] Attempting fallback with youtube-dl...');\n        return this.fallbackExtract(videoInput);\n      }\n      \n      throw error;\n    }\n  }\n\n  extractVideoId(input) {\n    // Check if it's already a video ID (11 characters)\n    if (/^[a-zA-Z0-9_-]{11}$/.test(input)) {\n      return input;\n    }\n\n    // Extract from various URL formats\n    const patterns = [\n      /(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/|youtube\\.com\\/embed\\/)([a-zA-Z0-9_-]{11})/,\n      /^([a-zA-Z0-9_-]{11})$/\n    ];\n\n    for (const pattern of patterns) {\n      const match = input.match(pattern);\n      if (match) return match[1];\n    }\n\n    return null;\n  }\n\n  async getVideoInfo(videoId) {\n    const info = await ytdl.getBasicInfo(videoId, {\n      requestOptions: this.buildRequestOptions()\n    });\n\n    const videoDetails = info.videoDetails;\n    const formats = info.formats;\n\n    return {\n      id: videoDetails.videoId,\n      title: videoDetails.title,\n      description: videoDetails.description,\n      channelId: videoDetails.channelId,\n      channelTitle: videoDetails.author.name,\n      viewCount: parseInt(videoDetails.viewCount),\n      likeCount: parseInt(videoDetails.likeCount) || null,\n      commentCount: parseInt(videoDetails.commentCount) || null,\n      duration: parseInt(videoDetails.lengthSeconds),\n      uploadDate: videoDetails.uploadDate,\n      thumbnails: videoDetails.thumbnails,\n      categories: info.category,\n      tags: videoDetails.keywords || [],\n      isLive: videoDetails.isLiveContent === 'true',\n      license: videoDetails.licensedContent ? 'standard' : 'creative_commons',\n      allowedRegions: videoDetails.regionRestriction?.blocked ? \n        { blocked: videoDetails.regionRestriction.blocked } : null,\n      formats: formats\n        .filter(f => f.hasVideo || f.hasAudio)\n        .map(f => ({\n          itag: f.itag,\n          qualityLabel: f.qualityLabel,\n          container: f.container,\n          hasVideo: f.hasVideo,\n          hasAudio: f.hasAudio,\n          contentLength: f.contentLength ? parseInt(f.contentLength) : null\n        }))\n    };\n  }\n\n  async getTranscript(videoId) {\n    try {\n      const captionTrack = await ytdl.getCaptionDownloads(videoId, {\n        requestOptions: this.buildRequestOptions()\n      });\n\n      const langCode = this.options.lang;\n      let caption = captionTrack.find(c => c.languageCode === langCode && !c.kind.includes('asr'));\n      \n      if (!caption) {\n        caption = captionTrack.find(c => c.languageCode.startsWith(langCode));\n      }\n      if (!caption) {\n        caption = captionTrack.find(c => !c.kind.includes('asr'));\n      }\n      if (!caption || captionTrack.length === 0) {\n        return { \n          available: false, \n          message: 'No captions available' \n        };\n      }\n\n      const url = caption.url;\n      const response = await fetch(url);\n      const xml = await response.text();\n\n      // Parse XML to extract segments\n      const segments = this.parseXmlTranscription(xml);\n\n      return {\n        available: true,\n        language: caption.languageCode,\n        isManual: !caption.kind.includes('asr'),\n        name: caption.name,\n        url: caption.url,\n        segments: segments\n      };\n    } catch (error) {\n      return {\n        available: false,\n        error: error.message\n      };\n    }\n  }\n\n  parseXmlTranscription(xml) {\n    const segments = [];\n    const textStart = xml.indexOf('<text start=');\n    \n    if (textStart === -1) return segments;\n\n    const textMatches = xml.match(/<text start=\"([^\"]+)\" dur=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/text>/g);\n    \n    if (textMatches) {\n      for (const match of textMatches) {\n        const startMatch = match.match(/start=\"([^\"]+)\"/);\n        const durMatch = match.match(/dur=\"([^\"]+)\"/);\n        const textContent = match.replace(/<\\/?[^>]+>/g, '').trim();\n        \n        if (startMatch && durMatch) {\n          segments.push({\n            start: parseFloat(startMatch[1]),\n            duration: parseFloat(durMatch[1]),\n            text: textContent\n          });\n        }\n      }\n    }\n\n    return segments;\n  }\n\n  async getComments(videoId) {\n    const comments = [];\n    let continuations = [''];\n    let count = 0;\n\n    while (continuations.length > 0 && count < this.options.maxComments) {\n      const continuation = continuations.shift();\n      \n      try {\n        const response = await ytdl.getComments(videoId, {\n          continuation,\n          requestOptions: this.buildRequestOptions()\n        });\n\n        for (const comment of response.comments) {\n          comments.push(this.formatComment(comment));\n          count++;\n\n          if (count >= this.options.maxComments) break;\n        }\n\n        if (response.continuation && count < this.options.maxComments) {\n          continuations.push(response.continuation);\n        }\n      } catch (error) {\n        console.warn(`[OSINT] Comment fetch error: ${error.message}`);\n        break;\n      }\n    }\n\n    return {\n      totalFetched: comments.length,\n      comments: comments\n    };\n  }\n\n  formatComment(comment) {\n    const obj = {\n      author: comment.author.name,\n      authorId: comment.author.id,\n      authorThumbnails: comment.author.thumbnails,\n      text: comment.text,\n      likeCount: comment.likeCount,\n      publishedAt: comment.publishedText,\n      replyCount: comment.replyCount,\n      isPinned: comment.isPinned,\n      isHearted: comment.isHearted\n    };\n\n    if (this.options.includeReplies && comment.replies && comment.replies.length > 0) {\n      obj.replies = comment.replies.map(reply => ({\n        author: reply.author.name,\n        authorId: reply.author.id,\n        text: reply.text,\n        likeCount: reply.likeCount,\n        publishedAt: reply.publishedText\n      }));\n    }\n\n    return obj;\n  }\n\n  buildRequestOptions() {\n    const options = {};\n    \n    if (this.options.proxy) {\n      options.proxy = this.options.proxy;\n    }\n    \n    if (this.options.cookies) {\n      options.headers = {\n        Cookie: this.readCookies()\n      };\n    }\n\n    return options;\n  }\n\n  readCookies() {\n    if (!fs.existsSync(this.options.cookies)) {\n      throw new Error(`Cookies file not found: ${this.options.cookies}`);\n    }\n    return fs.readFileSync(this.options.cookies, 'utf8');\n  }\n\n  async fallbackExtract(videoInput) {\n    try {\n      // Try youtube-dl-exec as fallback\n      const cmd = `youtube-dl --dump-json \"${videoInput}\" --no-playlist --restrict-filename`;\n      const { stdout } = await execAsync(cmd, { \n        maxBuffer: 10 * 1024 * 1024, // 10MB\n        timeout: 60000 \n      });\n\n      const info = JSON.parse(stdout);\n      \n      return {\n        videoId: info.id,\n        info: {\n          id: info.id,\n          title: info.title,\n          description: info.description,\n          channelId: info.channel_id,\n          channelTitle: info.channel,\n          viewCount: info.view_count,\n          likeCount: info.like_count,\n          duration: info.duration,\n          uploadDate: info.upload_date,\n          thumbnails: info.thumbnails,\n          formats: info.formats\n        },\n        _fallback: true\n      };\n    } catch (error) {\n      throw new Error(`All extraction methods failed: ${error.message}`);\n    }\n  }\n\n  async saveResults(results) {\n    let content;\n    \n    if (this.options.format === 'json') {\n      content = JSON.stringify(results, null, 2);\n    } else {\n      content = this.formatText(results);\n    }\n\n    await fs.promises.writeFile(this.options.output, content, 'utf8');\n    console.log(`[OSINT] Results saved to ${this.options.output}`);\n  }\n\n  formatText(results) {\n    const lines = [];\n    lines.push('===============================================');\n    lines.push('           YOUTUBE EXTRACTION REPORT          ');\n    lines.push('===============================================\\n');\n\n    if (results.info) {\n      const info = results.info;\n      lines.push('Video Information:');\n      lines.push(`  ID: ${info.id}`);\n      lines.push(`  Title: ${info.title}`);\n      lines.push(`  Channel: ${info.channelTitle} (${info.channelId})`);\n      lines.push(`  Duration: ${info.duration}s`);\n      lines.push(`  Views: ${info.viewCount?.toLocaleString() || 'N/A'}`);\n      lines.push(`  Likes: ${info.likeCount?.toLocaleString() || 'N/A'}`);\n      lines.push(`  Comments: ${info.commentCount?.toLocaleString() || 'N/A'}`);\n      lines.push(`  Upload Date: ${info.uploadDate || 'N/A'}`);\n      lines.push(`  Description: ${info.description ? info.description.substring(0, 200) + '...' : 'None'}`);\n      lines.push(`  Thumbnails: ${info.thumbnails.length} available`);\n      lines.push('');\n    }\n\n    if (results.transcript) {\n      const transcript = results.transcript;\n      lines.push('Transcript:');\n      lines.push(`  Available: ${transcript.available}`);\n      if (transcript.available) {\n        lines.push(`  Language: ${transcript.language} (${transcript.isManual ? 'manual' : 'auto'})`);\n        lines.push(`  Segments: ${transcript.segments.length}`);\n        lines.push('');\n        lines.push('  First 5 segments:');\n        for (let i = 0; i < Math.min(5, transcript.segments.length); i++) {\n          const seg = transcript.segments[i];\n          lines.push(`    [${seg.start.toFixed(2)}s] ${seg.text.substring(0, 80)}...`);\n        }\n      }\n      lines.push('');\n    }\n\n    if (results.comments) {\n      const comments = results.comments;\n      lines.push('Comments:');\n      lines.push(`  Fetched: ${comments.totalFetched}`);\n      lines.push('');\n      lines.push('  Top comments:');\n      for (let i = 0; i < Math.min(5, comments.comments.length); i++) {\n        const c = comments.comments[i];\n        lines.push(`    @${c.author}: ${c.text.substring(0, 80)}... (${c.likeCount} likes)`);\n      }\n      lines.push('');\n    }\n\n    return lines.join('\\n');\n  }\n}\n\n// CLI Interface\nif (import.meta.url === `file://${process.argv[1]}`) {\n  const args = parseArgs(process.argv.slice(2));\n  \n  const youtube = new OSINTYouTube(args.options);\n  \n  youtube.extract(args.videoId)\n    .then(results => {\n      console.log('[OSINT] Extraction complete.');\n      process.exit(0);\n    })\n    .catch(error => {\n      console.error('[OSINT] Extraction failed:', error.message);\n      process.exit(1);\n    });\n}\n\nfunction parseArgs(args) {\n  const result = { videoId: null, options: {} };\n  \n  for (let i = 0; i < args.length; i++) {\n    const arg = args[i];\n    \n    if (!arg.startsWith('-') && !result.videoId) {\n      result.videoId = arg;\n      continue;\n    }\n\n    switch (arg) {\n      case '--output':\n      case '-o':\n        result.options.output = args[++i];\n        break;\n      case '--format':\n      case '-f':\n        result.options.format = args[++i];\n        break;\n      case '--info':\n      case '-i':\n        result.options.info = true;\n        break;\n      case '--transcript':\n      case '-t':\n        result.options.transcript = true;\n        break;\n      case '--comments':\n      case '-c':\n        result.options.comments = true;\n        break;\n      case '--max-comments':\n      case '-m':\n        result.options.maxComments = parseInt(args[++i]);\n        break;\n      case '--lang':\n      case '-l':\n        result.options.lang = args[++i];\n        break;\n      case '--proxy':\n      case '-p':\n        result.options.proxy = args[++i];\n        break;\n      case '--cookies':\n      case '-C':\n        result.options.cookies = args[++i];\n        break;\n      case '--include-replies':\n      case '-r':\n        result.options.includeReplies = true;\n        break;\n    }\n  }\n\n  if (!result.videoId) {\n    console.error('Usage: osint-youtube <video-id-or-url> [options]');\n    process.exit(1);\n  }\n\n  return result;\n}\n\nexport default OSINTYouTube;","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\skills\\osint-youtube\\osint-youtube.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":22207,"output":3490,"cacheRead":0,"cacheWrite":0,"totalTokens":25697,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419619108}}
