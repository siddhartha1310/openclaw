{"type":"message","id":"04f0addf","parentId":"b889372c","timestamp":"2026-02-18T13:01:35.759Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now I need to create the main index.js that can act as a central dispatcher for all skills, and also create the comprehensive TOOLS-OSINT.md documentation.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_25b47279898f45369429f18e","name":"write","arguments":{"content":"#!/usr/bin/env node\n\n/**\n * OpenClaw OSINT Toolkit - Main dispatcher and unified interface\n */\n\nimport { readFile } from 'fs/promises';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\n\nclass OSINTToolkit {\n  constructor() {\n    this.skills = {\n      'osint-crawl': join(__dirname, 'skills', 'osint-crawl', 'osint-crawl.js'),\n      'osint-analyze': join(__dirname, 'skills', 'osint-analyze', 'osint-analyze.js'),\n      'osint-youtube': join(__dirname, 'skills', 'osint-youtube', 'osint-youtube.js'),\n      'osint-search-multi': join(__dirname, 'skills', 'osint-search-multi', 'osint-search-multi.js')\n    };\n  }\n\n  async listSkills() {\n    console.log('Available OSINT Skills:');\n    console.log('----------------------');\n    for (const [name, path] of Object.entries(this.skills)) {\n      try {\n        const metadata = await this.getSkillMetadata(path);\n        console.log(`\\n${name}:`);\n        console.log(`  Description: ${metadata.description || 'No description'}`);\n        console.log(`  Usage: ${metadata.usage || 'N/A'}`);\n      } catch (error) {\n        console.log(`\\n${name}: (metadata not available)`);\n      }\n    }\n  }\n\n  async getSkillMetadata(skillPath) {\n    // Read SKILL.md in same directory\n    const skillDir = dirname(skillPath);\n    const metadataPath = join(skillDir, 'SKILL.md');\n    \n    try {\n      const content = await readFile(metadataPath, 'utf8');\n      const description = content.match(/# .+?\\n\\n(.+?)\\n\\n/);\n      const usage = content.match(/## Usage\\n```\\n(.+?)\\n```/);\n      \n      return {\n        description: description ? description[1].trim() : null,\n        usage: usage ? usage[1].trim() : null,\n        path: skillPath\n      };\n    } catch (error) {\n      return { path: skillPath };\n    }\n  }\n\n  async run(skillName, args) {\n    const skillPath = this.skills[skillName];\n    \n    if (!skillPath) {\n      throw new Error(`Unknown skill: ${skillName}. Available: ${Object.keys(this.skills).join(', ')}`);\n    }\n\n    if (!require('fs').existsSync(skillPath)) {\n      throw new Error(`Skill file not found: ${skillPath}`);\n    }\n\n    // Dynamic import with args as environment/arguments\n    const skillModule = await import(skillPath);\n    const SkillClass = skillModule.default || skillModule;\n    \n    // Parse args into skill options\n    const { command, options } = this.parseArgs(args);\n    \n    // Instantiate and run\n    const instance = new SkillClass(options);\n    \n    if (skillName === 'osint-search-multi') {\n      return await instance.search(command);\n    } else if (skillName === 'osint-crawl') {\n      return await instance.crawl(command);\n    } else if (skillName === 'osint-analyze') {\n      return await instance.analyze(command);\n    } else if (skillName === 'osint-youtube') {\n      return await instance.extract(command);\n    } else {\n      return await instance.run(command);\n    }\n  }\n\n  parseArgs(args) {\n    const command = { options: {} };\n    \n    for (let i = 0; i < args.length; i++) {\n      const arg = args[i];\n      \n      if (!arg.startsWith('-') && !command.arg) {\n        command.arg = arg;\n        continue;\n      }\n\n      switch (arg) {\n        case '--depth':\n        case '-d':\n          command.options.depth = parseInt(args[++i]);\n          break;\n        case '--delay':\n        case '-D':\n          command.options.delay = parseInt(args[++i]);\n          break;\n        case '--max-pages':\n        case '-m':\n          command.options.maxPages = parseInt(args[++i]);\n          break;\n        case '--output':\n        case '-o':\n          command.options.output = args[++i];\n          break;\n        case '--format':\n        case '-f':\n          command.options.format = args[++i];\n          break;\n        // Add other common options...\n        default:\n          // Boolean flags\n          if (['--headless', '--respect-robots', '--include-external', '--trends'].includes(arg)) {\n            const key = arg.replace(/^--/, '').replace(/-/g, '');\n            command.options[key] = true;\n          }\n      }\n    }\n\n    return command;\n  }\n}\n\n// CLI Interface\nif (import.meta.url === `file://${process.argv[1]}`) {\n  const args = process.argv.slice(2);\n  \n  if (args.length === 0 || args[0] === '--help' || args[0] === '-h') {\n    console.log(`\nOpenClaw OSINT Toolkit - Unified Command Interface\n\nUSAGE:\n  osint-toolkit <skill> [skill-args]\n\nSKILLS:\n  osint-crawl        Recursive web crawling\n  osint-analyze      Dataset statistical analysis\n  osint-youtube      YouTube video extraction\n  osint-search-multi Multi-engine search\n\nEXAMPLES:\n  osint-toolkit osint-crawl https://example.com --depth 2\n  osint-toolkit osint-analyze data.csv --columns revenue,users\n  osint-toolkit osint-youtube dQw4w9WgXcQ --transcript\n  osint-toolkit osint-search-multi \"query\" --engines brave\n\nFor skill-specific help, run:\n  osint-toolkit <skill> --help\n    `);\n    process.exit(0);\n  }\n\n  const [skillName, ...skillArgs] = args;\n  const toolkit = new OSINTToolkit();\n\n  toolkit.run(skillName, skillArgs)\n    .then(() => process.exit(0))\n    .catch(error => {\n      console.error('[OSINT] Error:', error.message);\n      process.exit(1);\n    });\n}\n\nexport default OSINTToolkit;","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\index.js"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":29232,"output":1526,"cacheRead":0,"cacheWrite":0,"totalTokens":30758,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419679085}}
{"type":"message","id":"2d93a9d8","parentId":"04f0addf","timestamp":"2026-02-18T13:01:35.780Z","message":{"role":"toolResult","toolCallId":"call_25b47279898f45369429f18e","toolName":"write","content":[{"type":"text","text":"Successfully wrote 5267 bytes to D:\\workspace\\appDev\\openclaw\\workspace-osint\\index.js"}],"isError":false,"timestamp":1771419695778}}
{"type":"message","id":"bb80ab60","parentId":"2d93a9d8","timestamp":"2026-02-18T13:01:44.533Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now I'll create a README.md file for overall project documentation, and then the main TOOLS-OSINT.md file with comprehensive usage examples.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_66c839a32b8947b2bd424fcb","name":"write","arguments":{"content":"# OpenClaw OSINT Toolkit\n\nComprehensive open-source intelligence toolkit for OpenClaw with advanced web crawling, data analysis, YouTube extraction, and multi-engine search capabilities.\n\n## Features\n\n- **osint-crawl**: Recursive web crawler with depth limits, polite delays, robots.txt compliance, and support for both static (Cheerio) and dynamic (Puppeteer) sites\n- **osint-analyze**: Statistical analysis of datasets (CSV/JSON) with summary statistics, outlier detection, trends, and time-series analysis\n- **osint-youtube**: YouTube video information extractor with support for metadata, transcripts, and comments\n- **osint-search-multi**: Multi-engine search with Brave Search API integration and extensible architecture\n\n## Installation\n\n1. Install dependencies:\n```bash\nnpm install\n```\n\n2. (Optional) Set Brave Search API key for higher rate limits:\n```bash\nexport BRAVE_SEARCH_API_KEY=\"your-api-key\"\n```\n\n## Usage\n\n### Unified Interface\n```bash\nnode index.js <skill> [skill-specific-args]\n```\n\n### Individual Skills\n```bash\nnode skills/osint-crawl/osint-crawl.js https://example.com --depth 2 --output results.json\nnode skills/osint-analyze/osint-analyze.js data.csv --columns revenue,users --trends\nnode skills/osint-youtube/osint-youtube.js dQw4w9WgXcQ --transcript --comments\nnode skills/osint-search-multi/osint-search-multi.js \"cybersecurity\" --count 20\n```\n\n## Documentation\n\nSee `TOOLS-OSINT.md` for comprehensive documentation including:\n- Detailed skill specifications\n- Complete parameter reference\n- Usage examples and best practices\n- Capabilities and limitations\n- Troubleshooting guide\n\n## Requirements\n\n- Node.js >= 18.0.0\n- For Puppeteer: Chrome/Chromium (auto-downloaded)\n- For youtube-dl fallback: Python installed\n- Internet connectivity for all operations\n\n## Security & Ethics\n\n- Always respect robots.txt and rate limits\n- Use proxy for geo-restricted content\n- Do not extract private or copyrighted data without permission\n- Comply with YouTube Terms of Service\n- Cache results to minimize repeated requests\n\n## License\n\nMIT\n\n## Support\n\nFor issues, feature requests, or contributions, please open an issue on the repository.","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\README.md"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":30761,"output":617,"cacheRead":0,"cacheWrite":0,"totalTokens":31378,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419695780}}
{"type":"message","id":"d3d39d36","parentId":"bb80ab60","timestamp":"2026-02-18T13:01:44.548Z","message":{"role":"toolResult","toolCallId":"call_66c839a32b8947b2bd424fcb","toolName":"write","content":[{"type":"text","text":"Successfully wrote 2157 bytes to D:\\workspace\\appDev\\openclaw\\workspace-osint\\README.md"}],"isError":false,"timestamp":1771419704546}}
{"type":"message","id":"11ca1f68","parentId":"d3d39d36","timestamp":"2026-02-18T13:02:28.985Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the comprehensive TOOLS-OSINT.md documentation file with all the usage examples, capabilities, limitations, and installation steps.","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_b7da63dc68b54445ba133497","name":"write","arguments":{"content":"# OSINT Toolkit Documentation\n\n## Overview\n\nThis toolkit provides four main skills for OpenClaw:\n\n| Skill | Purpose | Key Features |\n|-------|---------|--------------|\n| `osint-crawl` | Web crawling | Recursive, depth-limited, robots.txt compliance, Puppeteer/Cheerio |\n| `osint-analyze` | Data analysis | Statistics, outliers, trends, time-series, groupby |\n| `osint-youtube` | YouTube extraction | Video info, transcripts, comments, fallback support |\n| `osint-search-multi` | Multi-engine search | Brave Search API, extensible, concurrent queries |\n\n## Installation\n\n### 1. Install Dependencies\n\n```bash\ncd D:\\workspace\\appDev\\openclaw\\workspace-osint\nnpm install\n```\n\nThis installs all required Node.js packages:\n\n- **Web Crawling**: `puppeteer`, `cheerio`, `axios`, `robots-parser`, `user-agents`, `p-limit`\n- **Data Analysis**: `simple-statistics`, `csv-parser`, `json2csv`, `fast-csv`\n- **YouTube**: `ytdl-core`, `youtube-dl-exec`, `node-fetch`\n- **Utilities**: Common dependencies shared across skills\n\n**Note**: Puppeteer will download Chromium on first run (~100MB). Ensure sufficient disk space.\n\n### 2. (Optional) Configure API Keys\n\n**Brave Search API** (for higher rate limits):\n```bash\n# Windows PowerShell\n$env:BRAVE_SEARCH_API_KEY=\"your-api-key-here\"\n\n# Linux/macOS\nexport BRAVE_SEARCH_API_KEY=\"your-api-key-here\"\n```\n\nGet a free API key at [Brave Search API](https://brave.com/search/api/).\n\n### 3. Test Installation\n\n```bash\n# List skills\nnode index.js --help\n\n# Test individual skill\nnode skills/osint-crawl/osint-crawl.js --help\n```\n\n## Skill Reference\n\n### 1. osint-crawl - Recursive Web Crawler\n\n#### Purpose\nControlled, recursive website crawling with depth limiting, rate limiting, and robots.txt compliance. Suitable for both static and JavaScript-heavy sites.\n\n#### Installation Check\n```bash\nnode skills/osint-crawl/osint-crawl.js --help\n```\n\n#### Basic Usage\n```bash\n# Simple crawl of a site\nnode skills/osint-crawl/osint-crawl.js https://example.com\n\n# With depth limit\nnode skills/osint-crawl/osint-crawl.js https://example.com --depth 2\n\n# Save to JSON\nnode skills/osint-crawl/osint-crawl.js https://example.com --depth 2 --output crawl.json\n\n# Aggressive crawl (use carefully)\nnode skills/osint-crawl/osint-crawl.js https://target.com \\\n  --depth 3 \\\n  --max-pages 200 \\\n  --delay 500 \\\n  --headless \\\n  --output results.json\n```\n\n#### All Parameters\n\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `url` | string | (required) | Starting URL |\n| `--depth, -d` | number | 2 | Maximum recursion depth |\n| `--delay, -D` | number | 1000 | Delay between requests (ms) |\n| `--max-pages, -m` | number | 50 | Maximum pages to crawl |\n| `--output, -o` | string | null | Output file path (.json or .csv) |\n| `--format, -f` | string | 'json' | Output format: 'csv' or 'json' |\n| `--respect-robots, -r` | boolean | true | Honor robots.txt directives |\n| `--user-agent, -u` | string | OSINT-Crawler/1.0 | Custom User-Agent |\n| `--timeout, -t` | number | 30000 | Request timeout (ms) |\n| `--include-external, -e` | boolean | false | Follow external links |\n| `--headless` | boolean | false | Use Puppeteer (for JS sites) |\n| `--extract-links` | boolean | true | Extract discovered links |\n\n#### Capabilities\n\n✅ **Polite Crawling**\n- robots.txt compliance with caching\n- Configurable delay between requests\n- Concurrent request limiting (2 concurrent)\n\n✅ **Flexible Extraction**\n- Static site parsing via Cheerio (fast, low resource)\n- Dynamic site parsing via Puppeteer (headless Chrome)\n- Link extraction and classification\n\n✅ **Export Options**\n- JSON output (structured)\n- CSV output (tabular, spreadsheet-friendly)\n\n❌ **Limitations**\n- Puppeteer mode is slower and resource-intensive\n- No cookie/session persistence across runs\n- No built-in URL normalization (may crawl duplicates)\n- Some sites block automated crawlers regardless of delays\n\n#### Output Structure (JSON)\n```json\n[\n  {\n    \"url\": \"https://example.com/page1\",\n    \"title\": \"Page Title\",\n    \"statusCode\": 200,\n    \"contentLength\": 12543,\n    \"links\": [\"https://example.com/page2\", \"...\"],\n    \"crawledAt\": \"2024-02-18T12:34:56Z\"\n  }\n]\n```\n\n---\n\n### 2. osint-analyze - Data Analysis\n\n#### Purpose\nStatistical analysis of datasets (CSV/JSON) with comprehensive statistics, outlier detection, trend analysis, and grouped statistics.\n\n#### Installation Check\n```bash\nnode skills/osint-analyze/osint-analyze.js --help\n```\n\n#### Basic Usage\n```bash\n# Analyze all numeric columns\nnode skills/osint-analyze/osint-analyze.js data.csv\n\n# Specific columns with IQR outlier detection\nnode skills/osint-analyze/osint-analyze.js data.json \\\n  --columns revenue,users,sessions \\\n  --outliers iqr \\\n  --output analysis.txt\n\n# Time-series analysis\nnode skills/osint-analyze/osint-analyze.js metrics.csv \\\n  --dates timestamp \\\n  --trends \\\n  --format json \\\n  --output trends.json\n\n# Grouped analysis by region\nnode skills/osint-analyze/osint-analyze.js sales.csv \\\n  --groupby region \\\n  --format csv \\\n  --output regional-stats.csv\n```\n\n#### All Parameters\n\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `file` | string | (required) | Input CSV or JSON file |\n| `--output, -o` | string | null | Output file (default: console) |\n| `--format, -f` | string | 'text' | Output: 'text', 'json', or 'csv' |\n| `--columns, -c` | string | all numeric | Comma-separated columns |\n| `--outliers, -O` | string | 'iqr' | Method: 'iqr' or 'zscore' |\n| `--threshold, -T` | number | 1.5 / 3 | Outlier threshold |\n| `--trends, -t` | boolean | false | Enable trend analysis |\n| `--dates, -d` | string | null | Date column for time-series |\n| `--groupby, -g` | string | null | Column to group by |\n\n#### Outlier Detection Methods\n\n**IQR (Interquartile Range)**\n- Robust to non-normal distributions\n- Uses quartiles Q1 (25th) and Q3 (75th)\n- Threshold: values outside `[Q1 - 1.5×IQR, Q3 + 1.5×IQR]`\n- Use for skewed distributions or unknown distribution\n\n**Z-Score**\n- Assumes roughly normal distribution\n- Threshold: values with `|z| > threshold` (default: 3)\n- Use for bell-shaped data\n\n#### Capabilities\n\n✅ **Comprehensive Statistics**\n- Count, mean, median, std dev, variance\n- Min/max, quartiles (Q1, Q3), IQR\n- Skewness, kurtosis\n- Sum\n\n✅ **Outlier Detection**\n- Two methods (IQR, z-score)\n- Configurable thresholds\n- Returns outlier values and counts\n\n✅ **Trend Analysis**\n- Linear regression (slope, intercept)\n- R² coefficient of determination\n- Pearson correlation (time-series)\n\n✅ **Grouped Analysis**\n- Separate stats by categorical column\n- Supports large number of groups\n\n❌ **Limitations**\n- Non-numeric columns ignored unless grouping/date\n- No interpolation for missing data (values excluded)\n- Linear regression assumes linear relationships\n- Date parsing requires consistent formats\n\n#### Output Structure (JSON)\n```json\n{\n  \"datasetInfo\": {\n    \"totalRecords\": 1000,\n    \"columnsAnalyzed\": 3,\n    \"analysisDate\": \"2024-02-18T12:34:56Z\"\n  },\n  \"statistics\": {\n    \"revenue\": {\n      \"count\": 1000,\n      \"mean\": 1250.50,\n      \"median\": 1100.00,\n      \"stdDev\": 450.25,\n      \"variance\": 202725.06,\n      \"min\": 100,\n      \"max\": 3500,\n      \"q1\": 850,\n      \"q3\": 1450,\n      \"iqr\": 600,\n      \"outliers\": [],\n      \"skewness\": 0.75,\n      \"kurtosis\": 2.34,\n      \"trends\": {\n        \"slope\": 2.5,\n        \"r2\": 0.89,\n        \"correlation\": 0.94,\n        \"n\": 1000\n      }\n    }\n  }\n}\n```\n\n---\n\n### 3. osint-youtube - YouTube Data Extractor\n\n#### Purpose\nExtract YouTube video metadata, transcripts/captions, and comments using ytdl-core with fallback to youtube-dl-exec.\n\n#### Installation Check\n```bash\nnode skills/osint-youtube/osint-youtube.js --help\n```\n\n#### Basic Usage\n```bash\n# Get video info only\nnode skills/osint-youtube/osint-youtube.js dQw4w9WgXcQ\n\n# Full extraction with transcript and comments\nnode skills/osint-youtube/osint-youtube.js https://youtu.be/dQw4w9WgXcQ \\\n  --transcript \\\n  --comments \\\n  --max-comments 50 \\\n  --output video-analysis.json\n\n# Extract transcript in specific language\nnode skills/osint-youtube/osint-youtube.js video-id \\\n  --transcript \\\n  --lang es \\\n  --format text\n\n# Extract comments with replies (requires more time)\nnode skills/osint-youtube/osint-youtube.js video-id \\\n  --comments \\\n  --include-replies \\\n  --max-comments 200\n```\n\n#### All Parameters\n\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `video-id-or-url` | string | (required) | YouTube video ID or URL |\n| `--output, -o` | string | null | Output file path |\n| `--format, -f` | string | 'text' | Output: 'text' or 'json' |\n| `--info, -i` | boolean | true | Extract video metadata |\n| `--transcript, -t` | boolean | false | Extract captions/transcript |\n| `--comments, -c` | boolean | false | Extract comments |\n| `--max-comments, -m` | number | 100 | Maximum comments to fetch |\n| `--lang, -l` | string | 'en' | Preferred transcript language |\n| `--proxy, -p` | string | null | Proxy URL (for geo-restricted) |\n| `--cookies, -C` | string | null | Path to cookies.txt file |\n| `--include-replies, -r` | boolean | false | Include comment replies |\n\n#### Capabilities\n\n✅ **Video Metadata**\n- Title, description, channel info\n- View count, like count, comment count\n- Duration, upload date, thumbnails\n- Categories, tags, license info\n- Format list (available quality levels)\n\n✅ **Transcripts**\n- Auto-generated and manual captions\n- Multiple language support\n- Timestamped segments\n- Fallback between manual/auto\n\n✅ **Comments**\n- Author info, text, likes\n- Publication timestamp\n- Reply count\n- Optional reply extraction\n\n✅ **Fallback Support**\n- Automatically tries youtube-dl if ytdl-core fails\n- Works with age-restricted/geo-blocked content (with cookies/proxy)\n\n❌ **Limitations**\n- Some videos have transcripts disabled\n- Comment extraction rate-limited by YouTube\n- Age-restricted videos require authenticated cookies\n- Geo-blocked content requires proxy\n- youtube-dl fallback requires Python installed\n- API changes may break functionality\n\n#### Output Structure (JSON)\n```json\n{\n  \"videoId\": \"dQw4w9WgXcQ\",\n  \"info\": {\n    \"id\": \"dQw4w9WgXcQ\",\n    \"title\": \"Never Gonna Give You Up\",\n    \"channelTitle\": \"Rick Astley\",\n    \"viewCount\": 1450000000,\n    \"likeCount\": 8500000,\n    \"duration\": 213,\n    \"uploadDate\": \"2009-10-25\",\n    \"thumbnails\": [...],\n    \"isLive\": false\n  },\n  \"transcript\": {\n    \"available\": true,\n    \"language\": \"en\",\n    \"isManual\": false,\n    \"segments\": [\n      { \"start\": 0.0, \"duration\": 2.5, \"text\": \"We're no strangers to love\" },\n      ...\n    ]\n  },\n  \"comments\": {\n    \"totalFetched\": 100,\n    \"comments\": [\n      {\n        \"author\": \"User123\",\n        \"text\": \"Great video!\",\n        \"likeCount\": 150,\n        \"replyCount\": 5,\n        \"replies\": [...]\n      }\n    ]\n  }\n}\n```\n\n---\n\n### 4. osint-search-multi - Multi-Engine Search\n\n#### Purpose\nSearch multiple engines simultaneously with Brave Search API as primary, extensible to include more engines.\n\n#### Installation Check\n```bash\nnode skills/osint-search-multi/osint-search-multi.js --help\n```\n\n#### Basic Usage\n```bash\n# Search Brave (default)\nnode skills/osint-search-multi/osint-search-multi.js \"openclaw framework\"\n\n# Specific engine and result count\nnode skills/osint-search-multi/osint-search-multi.js \"cybersecurity news\" \\\n  --engines brave \\\n  --count 20 \\\n  --output results.json\n\n# Localized and recent search\nnode skills/osint-search-multi/osint-search-multi.js \"osint tools 2024\" \\\n  --country US \\\n  --language en \\\n  --freshness pw \\\n  --format json \\\n  --output recent-osint.json\n```\n\n#### All Parameters\n\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `query` | string | (required) | Search query string |\n| `--engines, -e` | string[] | ['brave'] | Engines to query (comma-separated) |\n| `--count, -n` | number | 10 (max 50) | Results per engine |\n| `--output, -o` | string | null | Output file path |\n| `--format, -f` | string | 'text' | 'text', 'json', or 'csv' |\n| `--country, -c` | string | null | Country code (US, GB, IN, DE, etc.) |\n| `--language, -l` | string | null | Language code (en, es, fr, de, etc.) |\n| `--safeSearch, -s` | boolean | false | Enable SafeSearch filtering |\n| `--freshness, -F` | string | null | Time filter: pd (day), pw (week), pm (month), py (year) |\n| `--timeout, -t` | number | 30000 | Overall timeout (ms) |\n\n#### Available Engines\n\n| Engine | Status | Notes |\n|--------|--------|-------|\n| `brave` | ✅ Implemented | Free tier ~50 req/day, API recommended |\n| `google` | ⚠️ Placeholder | Requires Custom Search API setup |\n| `duckduckgo` | ⚠️ Limited | Instant Answer API only |\n| `bing` | ❌ Not implemented | - |\n| `startpage` | ❌ Not implemented | - |\n\n#### Capabilities\n\n✅ **Brave Search**\n- No API key required (free tier with limits)\n- Country/language localization\n- SafeSearch filtering\n- Freshness/time-based filters\n- Good result quality\n\n✅ **Extensible Architecture**\n- Base `SearchEngine` class for custom engines\n- Concurrent multi-engine queries\n- Partial result aggregation (doesn't fail all if one fails)\n- Standardized result format\n\n✅ **Export Formats**\n- Human-readable text summary\n- JSON for programmatic use\n- CSV for spreadsheets\n\n❌ **Limitations**\n- Brave API free tier has strict rate limits (use API key for production)\n- Only Brave fully implemented currently\n- No result deduplication across engines\n- No pagination beyond single query per engine\n- Google/Bing require commercial API keys\n\n#### Output Structure (JSON)\n```json\n{\n  \"query\": \"cybersecurity trends\",\n  \"enginesQueried\": [\"brave\"],\n  \"enginesSucceeded\": [\"brave\"],\n  \"totalResults\": 150,\n  \"timestamp\": \"2024-02-18T12:34:56Z\",\n  \"results\": [\n    {\n      \"engine\": \"brave\",\n      \"title\": \"Top 10 Cybersecurity Trends for 2024\",\n      \"url\": \"https://example.com/trends\",\n      \"snippet\": \"Exploring the latest cybersecurity trends...\",\n      \"publishedAt\": \"2024-01-15T10:30:00Z\",\n      \"source\": \"example.com\",\n      \"type\": \"news\"\n    }\n  ],\n  \"errors\": []\n}\n```\n\n---\n\n## Unified Interface\n\nThe `index.js` file provides a unified dispatcher:\n\n```bash\nnode index.js <skill> [args]\n```\n\nExamples:\n```bash\nnode index.js osint-crawl https://example.com --depth 1\nnode index.js osint-analyze data.csv --trends\nnode index.js osint-youtube dQw4w9WgXcQ --transcript\nnode index.js osint-search-multi \"query\" --count 10\n```\n\n## Integration with OpenClaw\n\n### As Skills\n\nEach skill can be registered in OpenClaw's skill registry:\n\n```javascript\n// Example registration (conceptual - actual implementation depends on OpenClaw)\nregisterSkill('osint-crawl', require('./skills/osint-crawl/osint-crawl.js'));\nregisterSkill('osint-analyze', require('./skills/osint-analyze/osint-analyze.js'));\nregisterSkill('osint-youtube', require('./skills/osint-youtube/osint-youtube.js'));\nregisterSkill('osint-search-multi', require('./skills/osint-search-multi/osint-search-multi.js'));\n```\n\n### Sandbox Compatibility\n\nAll tools are designed to run in OpenClaw's Node.js sandbox:\n\n- ✅ No interactive browsers (Puppeteer uses headless mode)\n- ✅ File I/O restricted to workspace\n- ✅ No external system calls (except youtube-dl fallback)\n- ✅ No package installation beyond npm install\n\n### Resource Considerations\n\n- **Crawler**: Puppeteer mode uses ~100-200MB RAM per instance\n- **YouTube**: Comment extraction can be memory-intensive (limit max-comments)\n- **Search**: Concurrent engine queries use minimal resources\n- **Analyze**: Large datasets (>1M rows) may need sampling\n\n## Troubleshooting\n\n### Puppeteer Issues\n```\nError: Failed to launch Chrome\n```\n- Ensure compatible Chrome/Chromium binary\n- On Linux: install additional dependencies (`apt-get install -y ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 libnspr4 libnss3 libx11-xcb1`)\n- Try forcing download: `npm install puppeteer --ignore-scripts && node node_modules/puppeteer/install.js`\n\n### YouTube Extraction Failures\n```\nError: This video is unavailable\n```\n- Check video is public and not age-restricted\n- For region-locked videos: use `--proxy` option\n- For age-restricted: use `--cookies` with authenticated browser export\n\n### Brave Search Rate Limiting\n```\nHTTP 429 Too Many Requests\n```\n- Free tier: ~50 requests/day without API key\n- Set `BRAVE_SEARCH_API_KEY` environment variable\n- Reduce query frequency or use alternative engines\n\n### Data Analysis Errors\n```\nTypeError: Cannot read property of undefined\n```\n- Ensure CSV has proper headers\n- Check for non-numeric values in numeric columns (they'll be skipped)\n- Verify date column format for time-series analysis\n\n## Performance Tips\n\n### Crawling\n- Start with `--depth 1` for quick reconnaissance\n- Use `--delay 2000` or higher to be polite\n- Avoid `--include-external` unless necessary (increases scope)\n- Use `--headless` only when needed (JS-heavy sites)\n\n### Analysis\n- Sample large datasets first: `head -n 10000 data.csv > sample.csv`\n- Use `--columns` to limit to relevant metrics\n- Grouped analysis is parallel - partitions data but computes separately\n\n### YouTube\n- Transcripts: prefer manual captions (`--lang` with correct code)\n- Comments: `--max-comments 50` usually sufficient for sentiment analysis\n- Use `--include-replies` only when reply analysis is needed (doubles requests)\n\n### Search\n- Use `--country` and `--language` for localized OSINT\n- `--freshness pw` (past week) for recent intelligence\n- Cache results to avoid repeated queries\n\n## Security & Ethics\n\n### Legal Compliance\n- **Web Crawling**: Respect robots.txt, rate limits, and Terms of Service\n- **YouTube**: Public data only; don't bypass authentication for private content\n- **Search**: Use public APIs; respect rate limits\n- **Data Storage**: Encrypt sensitive results; purge after analysis\n\n### Responsible Use\n- Don't target sites that prohibit crawling in robots.txt\n- Use `--delay` >= 2000ms for production crawling\n- Cache results to minimize server impact\n- Don't extract personal data without consent\n- Attribute sources when publishing findings\n\n## Extending the Toolkit\n\n### Adding New Search Engines\n\nCreate a new class extending `SearchEngine`:\n\n```javascript\nclass MySearchEngine extends SearchEngine {\n  constructor(apiKey) {\n    super('myengine');\n    this.apiKey = apiKey;\n  }\n\n  async search(query, options) {\n    const results = await fetch(`https://api.myengine.com/search?q=${query}&key=${this.apiKey}`);\n    const data = await results.json();\n    \n    return {\n      total: data.total,\n      results: this.normalizeResults(data.hits)\n    };\n  }\n}\n```\n\nThen add to `osint-search-multi` initialization.\n\n## Support & Updates\n\n- **Documentation**: This file (TOOLS-OSINT.md)\n- **Skill-specific**: Each skill has a `SKILL.md` in its directory\n- **Issues**: Report bugs or requests via GitHub Issues\n- **Updates**: Check `package.json` for latest compatible versions\n\n## License\n\nMIT - See LICENSE file for details.","file_path":"D:\\workspace\\appDev\\openclaw\\workspace-osint\\TOOLS-OSINT.md"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":31385,"output":5254,"cacheRead":0,"cacheWrite":0,"totalTokens":36639,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771419704548}}
