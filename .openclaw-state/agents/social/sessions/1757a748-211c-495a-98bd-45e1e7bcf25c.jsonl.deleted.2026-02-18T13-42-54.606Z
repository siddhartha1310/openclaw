installed. Let's try to explicitly get the path: `require.resolve('pdfjs-dist/legacy/build/pdf.worker.js')` would give the resolved filename. That's a string. That could be used as workerSrc.\n\nWe could set:\n\npdfjsLib.GlobalWorkerOptions.workerSrc = require.resolve('pdfjs-dist/legacy/build/pdf.worker.js');\n\nThat ensures we get a string path. Let's try that.\n\nChange loadExternalModules:\n\nconst workerPath = require.resolve('pdfjs-dist/legacy/build/pdf.worker.js');\npdfjsLib.GlobalWorkerOptions.workerSrc = workerPath;\n\nThat should be a string.\n\nLet's implement that.","thinkingSignature":"reasoning"},{"type":"text","text":"The error suggests workerSrc is not a string. I'll use `require.resolve` to get the actual path string:"},{"type":"toolCall","id":"call_cd8b9cb329a1467289f8a822","name":"edit","arguments":{"file_path":"D:\\workspace\\appDev\\openclaw\\workspace-social\\analyze-and-generate.js","old_string":"function loadExternalModules() {\n  // Try to load canvas implementation: prefer @napi-rs/canvas, fallback to canvas\n  let canvasModule;\n  try {\n    canvasModule = require('@napi-rs/canvas');\n    console.log('Using @napi-rs/canvas.');\n  } catch (e) {\n    canvasModule = require('canvas');\n    console.log('Using canvas.');\n  }\n  createCanvas = canvasModule.createCanvas;\n  // pdfjs-dist\n  pdfjsLib = require('pdfjs-dist/legacy/build/pdf.js');\n  pdfjsLib.GlobalWorkerOptions.workerSrc = require('pdfjs-dist/legacy/build/pdf.worker.js');\n  console.log('External modules loaded.');\n}","new_string":"function loadExternalModules() {\n  // Try to load canvas implementation: prefer @napi-rs/canvas, fallback to canvas\n  let canvasModule;\n  try {\n    canvasModule = require('@napi-rs/canvas');\n    console.log('Using @napi-rs/canvas.');\n  } catch (e) {\n    canvasModule = require('canvas');\n    console.log('Using canvas.');\n  }\n  createCanvas = canvasModule.createCanvas;\n  // pdfjs-dist\n  pdfjsLib = require('pdfjs-dist/legacy/build/pdf.js');\n  /