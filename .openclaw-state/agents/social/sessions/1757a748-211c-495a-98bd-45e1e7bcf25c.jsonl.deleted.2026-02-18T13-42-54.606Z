{"type":"message","id":"fee1d423","parentId":"f4698b30","timestamp":"2026-02-18T12:48:49.388Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Continue with generateTheme:","thinkingSignature":"reasoning"},{"type":"toolCall","id":"call_d30225e69ed446b9a062513b","name":"edit","arguments":{"file_path":"D:\\workspace\\appDev\\openclaw\\workspace-social\\analyze-and-generate.js","old_string":"// Step 6: Generate Marp CSS theme\nfunction generateTheme(dominantColors, layoutInfo) {\n  console.log('Generating Marp CSS theme...');\n\n  // Heuristic: The most frequent color is likely background or text.\n  // We can sample: if the top color is light (high luminance), assume it's background; if dark, assume text.\n  // Compute luminance: 0.299*R + 0.587*G + 0.114*B\n  const getLuminance = (c) => 0.299 * c.r + 0.587 * c.g + 0.114 * c.b;\n\n  // Map colors to hex\n  const toHex = (c) => '#' + [c.r, c.g, c.b].map(x => x.toString(16).padStart(2, '0')).join('');\n\n  // Sort by frequency (already sorted most frequent first)\n  const topColor = dominantColors[0];\n  const secondColor = dominantColors[1];\n  const thirdColor = dominantColors[2];\n\n  // Determine if background is light or dark\n  const topLum = getLuminance(topColor);\n  let backgroundColor, textColor, accentColor, secondaryColor;\n\n  if (topLum > 128) {\n    // Light background\n    backgroundColor = toHex(topColor);\n    textColor = '#222222'; // dark text\n    accentColor = secondColor ? toHex(secondColor) : '#0066cc';\n    secondaryColor = thirdColor ? toHex(thirdColor) : '#ff6600';\n  } else {\n    // Dark background\n    backgroundColor = toHex(topColor);\n    textColor = '#eeeeee'; // light text\n    accentColor = secondColor ? toHex(secondColor) : '#4da6ff';\n    secondaryColor = thirdColor ? toHex(thirdColor) : '#ff9933';\n  }\n\n  // Font size scaling: We need to map the PDF's typical font size to slide CSS font size.\n  // The slide dimensions are 1000x1200. The PDF's font size in points might need scaling.\n  // Approximate: target slide font size ~ 32px for body. We'll compute ratio based on typicalFontSize from PDF (which might be in points, 1pt = 1/72 inch, but at 96 DPI screen maybe 1.333px per pt). It's messy.\n  // Simpler: Set body font size to something like 28px; then headers scale relative.\n  const baseFontSize = Math.round(layoutInfo.typicalFontSize * 0.7); // rough scaling to slide\n  const headerScale = 1.8; // h1 relative to body\n\n  // Build CSS string\n  const css = `@theme \"custom-from-pdf\";\n/* Generated by analyze-and-generate.js */\nsection {\n  width: ${CONFIG.slideWidth}px;\n  height: ${CONFIG.slideHeight}px;\n  background-color: ${backgroundColor};\n  color: ${textColor};\n  font-family: \"${layoutInfo.primaryFontFamily}\", sans-serif;\n  font-size: ${baseFontSize}px;\n  line-height: 1.5;\n  padding: ${Math.round(layoutInfo.margins ? layoutInfo.margins.left * 0.5 : 50)}px ${Math.round(layoutInfo.margins ? layoutInfo.margins.right * 0.5 : 50)}px;\n}\n\n/* Headings */\nh1, h2, h3 {\n  color: ${accentColor};\n  font-weight: bold;\n}\nh1 {\n  font-size: ${Math.round(baseFontSize * headerScale)}px;\n  margin-bottom: 0.5em;\n}\nh2 {\n  font-size: ${Math.round(baseFontSize * headerScale * 0.85)}px;\n}\nh3 {\n  font-size: ${Math.round(baseFontSize * headerScale * 0.7)}px;\n}\n\n/* Links and accents */\na {\n  color: ${accentColor};\n}\n\n/* Use secondary color for highlights, blockquotes, etc. */\nmark, blockquote {\n  background-color: ${secondaryColor}33; /* 20% opacity */\n  border-left: 4px solid ${secondaryColor};\n  padding: 0.2em 0.5em;\n}\n`;\n\n  writeFile(CONFIG.themeCssPath, css);\n  console.log('Theme CSS generated.');\n}","new_string":"// Step 6: Generate Marp CSS theme\nfunction generateTheme(dominantColors, layoutInfo) {\n  log('Generating Marp CSS theme...');\n\n  // Heuristic: The most frequent color is likely background or text.\n  // We can sample: if the top color is light (high luminance), assume it's background; if dark, assume text.\n  // Compute luminance: 0.299*R + 0.587*G + 0.114*B\n  const getLuminance = (c) => 0.299 * c.r + 0.587 * c.g + 0.114 * c.b;\n\n  // Map colors to hex\n  const toHex = (c) => '#' + [c.r, c.g, c.b].map(x => x.toString(16).padStart(2, '0')).join('');\n\n  // Sort by frequency (already sorted most frequent first)\n  const topColor = dominantColors[0];\n  const secondColor = dominantColors[1];\n  const thirdColor = dominantColors[2];\n\n  // Determine if background is light or dark\n  const topLum = getLuminance(topColor);\n  let backgroundColor, textColor, accentColor, secondaryColor;\n\n  if (topLum > 128) {\n    // Light background\n    backgroundColor = toHex(topColor);\n    textColor = '#222222'; // dark text\n    accentColor = secondColor ? toHex(secondColor) : '#0066cc';\n    secondaryColor = thirdColor ? toHex(thirdColor) : '#ff6600';\n  } else {\n    // Dark background\n    backgroundColor = toHex(topColor);\n    textColor = '#eeeeee'; // light text\n    accentColor = secondColor ? toHex(secondColor) : '#4da6ff';\n    secondaryColor = thirdColor ? toHex(thirdColor) : '#ff9933';\n  }\n\n  // Font size scaling: We need to map the PDF's typical font size to slide CSS font size.\n  const baseFontSize = Math.round(layoutInfo.typicalFontSize * 0.7); // rough scaling to slide\n  const headerScale = 1.8; // h1 relative to body\n\n  // Build CSS string\n  const css = `@theme \"custom-from-pdf\";\n/* Generated by analyze-and-generate.js */\nsection {\n  width: ${CONFIG.slideWidth}px;\n  height: ${CONFIG.slideHeight}px;\n  background-color: ${backgroundColor};\n  color: ${textColor};\n  font-family: \"${layoutInfo.primaryFontFamily}\", sans-serif;\n  font-size: ${baseFontSize}px;\n  line-height: 1.5;\n  padding: ${Math.round(layoutInfo.margins ? layoutInfo.margins.left * 0.5 : 50)}px ${Math.round(layoutInfo.margins ? layoutInfo.margins.right * 0.5 : 50)}px;\n}\n\n/* Headings */\nh1, h2, h3 {\n  color: ${accentColor};\n  font-weight: bold;\n}\nh1 {\n  font-size: ${Math.round(baseFontSize * headerScale)}px;\n  margin-bottom: 0.5em;\n}\nh2 {\n  font-size: ${Math.round(baseFontSize * headerScale * 0.85)}px;\n}\nh3 {\n  font-size: ${Math.round(baseFontSize * headerScale * 0.7)}px;\n}\n\n/* Links and accents */\na {\n  color: ${accentColor};\n}\n\n/* Use secondary color for highlights, blockquotes, etc. */\nmark, blockquote {\n  background-color: ${secondaryColor}33; /* 20% opacity */\n  border-left: 4px solid ${secondaryColor};\n  padding: 0.2em 0.5em;\n}\n`;\n\n  writeFile(CONFIG.themeCssPath, css);\n  log('Theme CSS generated.');\n}"}}],"api":"openai-completions","provider":"openrouter","model":"stepfun/step-3.5-flash:free","usage":{"input":36294,"output":1870,"cacheRead":0,"cacheWrite":0,"totalTokens":38164,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771418919271}}
