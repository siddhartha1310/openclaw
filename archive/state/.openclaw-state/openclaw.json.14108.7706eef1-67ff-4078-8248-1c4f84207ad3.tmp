  "tools": {
    "profile": "full",
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "maxResults": 10,
        "timeoutSeconds": 30
      },
      "fetch": {
        "enabled": true,
        "maxChars": 50000,
        "timeoutSeconds": 45,
        "maxRedirects": 5
      }
    },
    "media": {
      "image": {
        "enabled": true,
        "maxBytes": 5242880,
        "maxChars": 2000,
        "timeoutSeconds": 60
      }
    },
    "message": {
      "allowCrossContextSend": true,
      "crossContext": {
        "allowWithinProvider": true,
        "allowAcrossProviders": false
      }
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off",
      "backgroundMs": 10000,
      "timeoutSec": 300,
      "applyPatch": {
        "enabled": true,
        "workspaceOnly": true
      }
    },
    "fs": {
      "workspaceOnly": false
    }
